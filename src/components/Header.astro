---
const navLinks = [
  { href: '/',             arLabel: 'الرئيسية',    enLabel: 'Home' },
  { href: '/about/',       arLabel: 'من نحن',      enLabel: 'About' },
  { href: '/services/',    arLabel: 'خدماتنا',     enLabel: 'Services' },
  { href: '/gallery/',     arLabel: 'معرض الأعمال',enLabel: 'Gallery' },
  { href: '/areas/',       arLabel: 'مناطق الخدمة',enLabel: 'Areas' },
  { href: '/blog/',        arLabel: 'المدونة',     enLabel: 'Blog' },
  { href: '/testimonials/',arLabel: 'آراء العملاء', enLabel: 'Reviews' },
  { href: '/faq/',         arLabel: 'الأسئلة الشائعة', enLabel: 'FAQ' },
  { href: '/contact/',     arLabel: 'تواصل معنا',  enLabel: 'Contact' },
];
---

<header id="site-header" aria-label="رأس الصفحة">
  <div class="header-inner container">

    <!-- Logo: Real logo from user's assets folder -->
    <a href="/" class="header-logo" aria-label="صيانة مطابخ الدمام - الصفحة الرئيسية">
      <img
        src="/assets/logo/logo-transparent.png"
        alt="شعار صيانة مطابخ وإصلاح مفصلات في الدمام"
        class="logo-img logo-light"
        width="160"
        height="64"
        fetchpriority="high"
        loading="eager"
      />
      <img
        src="/assets/logo/2.png"
        alt="شعار صيانة مطابخ وإصلاح مفصلات في الدمام"
        class="logo-img logo-dark"
        width="160"
        height="64"
        fetchpriority="high"
        loading="eager"
      />
    </a>

    <!-- Desktop Nav -->
    <nav id="desktop-nav" aria-label="قائمة التنقل الرئيسية">
      <ul>
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              data-ar={link.arLabel}
              data-en={link.enLabel}
              class:list={['nav-link', Astro.url.pathname === link.href ? 'active' : '']}
              aria-label={link.arLabel}
            >
              {link.arLabel}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Controls -->
    <div class="header-controls">
      <!-- Dark Mode Toggle -->
      <button
        id="theme-toggle"
        class="ctrl-btn"
        aria-label="تبديل الوضع المضيء/المظلم"
        title="تبديل الوضع"
      >
        <span id="theme-icon">🌙</span>
      </button>

      <!-- Language Toggle -->
      <button
        id="lang-toggle"
        class="ctrl-btn lang-btn"
        aria-label="تبديل اللغة"
        title="Switch Language"
      >
        EN
      </button>

      <!-- WhatsApp CTA -->
      <a
        href="https://wa.me/966552854516?text=مرحباً، أحتاج خدمة صيانة مطابخ في الدمام"
        class="btn btn-whatsapp header-wa"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="تواصل واتساب"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span data-ar="واتساب" data-en="WhatsApp">واتساب</span>
      </a>

      <!-- Mobile Hamburger -->
      <button
        id="mobile-menu-toggle"
        class="ctrl-btn hamburger"
        aria-label="فتح القائمة"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        ☰
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <nav id="mobile-menu" aria-label="قائمة الجوال">
    <ul>
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            data-ar={link.arLabel}
            data-en={link.enLabel}
            class="nav-link"
          >
            {link.arLabel}
          </a>
        </li>
      ))}
    </ul>
    <div class="mobile-cta">
      <a
        href="tel:+966552854516"
        class="btn btn-secondary"
        aria-label="اتصل بنا"
      >
        📞 0552854516
      </a>
    </div>
  </nav>
</header>

<style>
/* ===================== HEADER ===================== */
#site-header {
  position: fixed;
  top: 0;
  inset-inline: 0;
  z-index: 1000;
  background: var(--bg-header);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid transparent;
  transition: var(--transition);
  height: var(--header-height);
}

#site-header.scrolled {
  border-bottom-color: var(--border-color);
  box-shadow: var(--shadow-md);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  height: 100%;
}

/* Logo */
.header-logo {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.logo-img {
  height: 54px;
  width: auto;
  object-fit: contain;
  border-radius: 8px;
}

.logo-dark {
  display: none;
}

[data-theme="dark"] .logo-light {
  display: none;
}

[data-theme="dark"] .logo-dark {
  display: block;
}

/* Desktop Nav */
#desktop-nav ul {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  flex-wrap: nowrap;
}

.nav-link {
  padding: 0.4rem 0.75rem;
  border-radius: 8px;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-secondary);
  transition: var(--transition-fast);
  white-space: nowrap;
}

.nav-link:hover,
.nav-link.active {
  color: var(--color-primary);
  background: rgba(182, 123, 89, 0.12);
}

/* Controls */
.header-controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-shrink: 0;
}

.ctrl-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  font-size: 1rem;
  color: var(--text-secondary);
  background: var(--bg-section-alt);
  border: 1px solid var(--border-color);
  transition: var(--transition-fast);
  cursor: pointer;
}

.ctrl-btn:hover {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

.lang-btn {
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 1px;
}

.header-wa {
  padding: 0.5rem 1rem;
  font-size: 0.8rem;
  border-radius: 10px;
}

.hamburger {
  display: none;
  font-size: 1.25rem;
}

/* Mobile Menu */
#mobile-menu {
  display: none;
  background: var(--bg-card);
  border-top: 1px solid var(--border-color);
  padding: 1rem;
}

#mobile-menu.open {
  display: block;
  animation: fadeInUp 0.2s ease;
}

#mobile-menu ul {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.5rem;
  margin-bottom: 1rem;
}

#mobile-menu .nav-link {
  display: block;
  padding: 0.75rem;
  border-radius: 10px;
  text-align: center;
  background: var(--bg-section-alt);
  font-size: 0.875rem;
}

.mobile-cta {
  text-align: center;
  margin-top: 0.5rem;
}

.mobile-cta .btn {
  width: 100%;
}

/* Responsive */
@media (max-width: 1024px) {
  #desktop-nav { display: none; }
  .header-wa { display: none; }
  .hamburger { display: flex; }
  #mobile-menu { display: none; }
  #mobile-menu.open { display: block; }
}

@media (max-width: 768px) {
  .header-inner { gap: 0.5rem; }
  .logo-img { height: 44px; }
}
</style>
