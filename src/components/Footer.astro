<style>
#site-footer {
  background: var(--bg-footer);
  color: rgba(255,255,255,0.85);
  margin-top: auto;
}

.footer-top {
  padding: 4rem 0 3rem;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
  gap: 2.5rem;
}

.footer-logo {
  height: 58px;
  width: auto;
  object-fit: contain;
  margin-bottom: 1.25rem;
  border-radius: 8px;
}

.footer-brand p {
  font-size: 0.875rem;
  line-height: 1.8;
  color: rgba(255,255,255,0.7);
  margin-bottom: 1.5rem;
  text-align: start;
}

.footer-contact-quick {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.quick-contact {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.9rem;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
  transition: var(--transition-fast);
}

.quick-contact:hover {
  color: var(--color-accent);
}

.quick-contact.wa {
  color: #25D366;
}

.quick-contact .icon { font-size: 1.1rem; }

.footer-col h3 {
  font-size: 1rem;
  font-weight: 800;
  color: var(--color-accent);
  margin-bottom: 1.25rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid rgba(237, 186, 154, 0.25);
}

.footer-col ul li {
  margin-bottom: 0.6rem;
}

.footer-col ul li a {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.7);
  transition: var(--transition-fast);
  display: block;
}

.footer-col ul li a:hover {
  color: var(--color-accent);
  transform: translateX(-4px);
}

[dir="ltr"] .footer-col ul li a:hover {
  transform: translateX(4px);
}

.footer-info { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem; }

.info-item {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}

.info-icon { font-size: 1.1rem; margin-top: 2px; flex-shrink: 0; }

.info-item strong {
  display: block;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--color-accent);
  margin-bottom: 0.25rem;
}

.info-item p {
  font-size: 0.8rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
  text-align: start;
}

.footer-cta {
  width: 100%;
  justify-content: center;
  font-size: 0.875rem;
  padding: 0.65rem 1.25rem;
}

/* Footer Bottom */
.footer-bottom {
  background: rgba(0,0,0,0.35);
  padding: 1.25rem 0;
  border-top: 1px solid rgba(255,255,255,0.08);
}

.copyright {
  text-align: center;
  font-size: 0.825rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.8;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.copyright .sep {
  opacity: 0.35;
}

.dev-credit {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  flex-wrap: wrap;
  justify-content: center;
}

.dev-credit strong {
  color: var(--color-accent);
}

.fortech-wa-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  background: rgba(37, 211, 102, 0.15);
  color: #25D366;
  border: 1px solid rgba(37, 211, 102, 0.4);
  padding: 2px 8px;
  border-radius: 14px;
  font-size: 0.75rem;
  font-weight: 700;
  transition: all 0.2s ease;
  margin-inline-start: 0.25rem;
}

.fortech-wa-link:hover {
  background: #25D366;
  color: #ffffff;
  transform: translateY(-1px);
  box-shadow: 0 4px 10px rgba(37,211,102,0.3);
}

/* Responsive */
@media (max-width: 1024px) {
  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .footer-brand { grid-column: span 2; }
}

@media (max-width: 768px) {
  .footer-grid { grid-template-columns: 1fr; }
  .footer-brand { grid-column: span 1; }
  .footer-brand p { text-align: center; }
  .footer-contact-quick { align-items: center; }
  .footer-col { text-align: center; }
  .footer-col ul li a:hover { transform: none; }
  .info-item { justify-content: center; }
  .info-item p { text-align: center; }
}
</style>
