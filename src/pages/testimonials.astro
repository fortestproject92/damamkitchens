---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';

const reviews = [
  {
    nameAr: "أبو فهد القحطاني",
    nameEn: "Abu Fahad Al-Qahtani",
    locationAr: "حي الشاطئ، الدمام",
    locationEn: "Al Shatea, Dammam",
    serviceAr: "تغيير كامل مفصلات المطبخ لهيدروليك",
    serviceEn: "Complete Hydraulic Hinge Replacement",
    rating: 5,
    dateAr: "منذ 3 أيام",
    dateEn: "3 days ago",
    commentAr: "ما شاء الله تبارك الله، قمة في الأخلاق والالتزام بالمواعيد. الأبواب كانت ساقطة وتصدر صوتاً مزعجاً، الفني غير كل المفصلات لمفصلات هيدروليكية إيطالية وصار المطبخ يقفل بنعومة تامة. عمل متقن ونظيف جداً وسعر الخدمة ممتاز ومناسب.",
    commentEn: "Excellent manners and punctual arrival. The doors were misaligned and squeaking loudly. The technician upgraded everything to Italian soft-close hinges, shutting like silk. Extremely clean and professional work."
  },
  {
    nameAr: "أم عبد الله الدوسري",
    nameEn: "Um Abdullah Al-Dossary",
    locationAr: "حي الحزام الذهبي، الخبر",
    locationEn: "Golden Belt, Khobar",
    serviceAr: "إصلاح سحابات أدراج المطبخ الثقيلة",
    serviceEn: "Heavy Kitchen Drawer Slides Repair",
    rating: 5,
    dateAr: "منذ أسبوع",
    dateEn: "1 week ago",
    commentAr: "أدراج القدور كانت عالقة وما تفتح للآخر، الفني فحصها وغير السكك بنوع رولمان بلي عالي التحمل. الحين الدرج يفتح بالكامل وبلمسة إصبع واحدة. يعطيهم العافية على السرعة والأمانة.",
    commentEn: "Heavy pot drawers were jammed. The technician replaced worn runners with heavy-duty ball-bearing rails. Now drawers slide out completely with a gentle push. Exceptional honesty and speed."
  },
  {
    nameAr: "م. خالد الغامدي",
    nameEn: "Eng. Khalid Al-Ghamdi",
    locationAr: "حي الدانة، الظهران",
    locationEn: "Al Danah, Dhahran",
    serviceAr: "وزن أبواب مطبخ ألمنيوم وتعديل الفواصل",
    serviceEn: "Aluminum Door Alignment & Gap Tuning",
    rating: 5,
    dateAr: "منذ أسبوعين",
    dateEn: "2 weeks ago",
    commentAr: "تواصلت معهم الساعة 10 مساءً وردوا علي فوراً، وحضر الفني في اليوم التالي بالموعد تماماً. وزنية الأبواب والفواصل رجعت كأن المطبخ مركب اليوم. خدمة محترمة أنصح بالتعامل معهم بشدة.",
    commentEn: "Contacted them late at 10 PM and received an instant response. Technician arrived punctually next morning. Door lines are perfectly level now like day one. Highly recommended service."
  },
  {
