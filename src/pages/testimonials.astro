  },
  {
    nameAr: "بندر الشمري",
    nameEn: "Bandar Al-Shammari",
    locationAr: "ضاحية الملك فهد، الدمام",
    locationEn: "King Fahd Suburb, Dammam",
    serviceAr: "صيانة طارئة لمفصلات كابينة زجاجية",
