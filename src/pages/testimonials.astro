---

<Layout
  title="آراء وتقييمات العملاء | صيانة مطابخ وإصلاح مفصلات الدمام"
  description="اقرأ تجارب وتقييمات عملائنا الحقيقية في صيانة مطابخ الألمنيوم والخشب وتغيير المفصلات في الدمام، الخبر، والظهران. تقييم 4.9 من 5 بناءً على مئات التجارب الناجحة."
  page="testimonials"
>
  <Header slot="header" />

  <section class="page-hero" style="background-image: url('/assets/15.jpg');">
    <div class="container">
      <h1 data-ar="آراء وتقييمات عملائنا الكرام" data-en="Customer Reviews & Testimonials">آراء وتقييمات عملائنا الكرام</h1>
      <p data-ar="ثقة مئات العائلات في الدمام والمنطقة الشرقية هي وسام فخرنا وأكبر دافع لاستمرار تميزنا." data-en="The trust of hundreds of families across Dammam and Eastern Province is our proudest badge of honor.">
        ثقة مئات العائلات في الدمام والمنطقة الشرقية هي وسام فخرنا وأكبر دافع لاستمرار تميزنا.
      </p>
    </div>
  </section>

  <!-- OVERALL SCORE BANNER -->
  <section class="section section-alt rating-overview-section">
    <div class="container">
      <div class="card rating-summary-card">
        <div class="score-box">
          <span class="big-score">4.9</span>
          <div class="stars">★★★★★</div>
          <span class="score-sub" data-ar="تقييم عام ممتاز" data-en="Overall Excellent Rating">تقييم عام ممتاز</span>
        </div>

        <div class="score-bars">
          <div class="score-bar-row">
            <span>5 نجوم</span>
            <div class="bar-track"><div class="bar-fill" style="width: 95%;"></div></div>
            <span>95%</span>
          </div>
          <div class="score-bar-row">
            <span>4 نجوم</span>
            <div class="bar-track"><div class="bar-fill" style="width: 5%;"></div></div>
            <span>5%</span>
          </div>
          <div class="score-bar-row">
            <span>3 نجوم</span>
            <div class="bar-track"><div class="bar-fill" style="width: 0%;"></div></div>
            <span>0%</span>
          </div>
        </div>

        <div class="score-cta-box">
          <h3 data-ar="انضم إلى قائمة عملائنا الراضين" data-en="Join Our Satisfied Clients">انضم إلى قائمة عملائنا الراضين</h3>
          <p data-ar="احصل على صيانة احترافية لمطبخك اليوم بضمان ورضا تام." data-en="Experience professional kitchen repairs with 100% satisfaction guaranteed.">احصل على صيانة احترافية لمطبخك اليوم بضمان ورضا تام.</p>
          <a href="https://wa.me/966552854516?text=مرحباً، أود حجز فني صيانة مطابخ" class="btn btn-whatsapp" target="_blank" rel="noopener noreferrer">
            <span>💬</span>
            <span data-ar="احجز صيانة مطبخك الآن" data-en="Book Your Repair Now">احجز صيانة مطبخك الآن</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS GRID -->
  <section class="section">
    <div class="container">
      <div class="grid-3 reviews-grid">
        {reviews.map((rev) => (
          <article class="card review-card">
            <div class="review-header">
              <div class="reviewer-avatar">👤</div>
              <div>
                <h3 class="reviewer-name" data-ar={rev.nameAr} data-en={rev.nameEn}>{rev.nameAr}</h3>
                <span class="reviewer-loc">📍 <span data-ar={rev.locationAr} data-en={rev.locationEn}>{rev.locationAr}</span></span>
              </div>
            </div>

            <div class="review-stars-row">
              <span class="stars">{'★'.repeat(rev.rating)}</span>
              <span class="review-date" data-ar={rev.dateAr} data-en={rev.dateEn}>{rev.dateAr}</span>
            </div>

            <div class="review-srv-tag">
              <span data-ar={rev.serviceAr} data-en={rev.serviceEn}>{rev.serviceAr}</span>
            </div>

            <p class="review-comment" data-ar={rev.commentAr} data-en={rev.commentEn}>{rev.commentAr}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FloatingCTA />
  <Footer slot="footer" />
</Layout>

<style>
.rating-summary-card {
  display: grid;
  grid-template-columns: 1fr 1.5fr 1.5fr;
  gap: 2.5rem;
  align-items: center;
  padding: 3rem;
}

.score-box {
  text-align: center;
  border-inline-end: 1px solid var(--border-color);
  padding-inline-end: 2rem;
}

.big-score {
  font-size: 4rem;
  font-weight: 900;
  color: var(--color-primary);
  line-height: 1;
}

.score-sub {
  display: block;
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--text-secondary);
  margin-top: 0.5rem;
}

.score-bars {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  border-inline-end: 1px solid var(--border-color);
  padding-inline-end: 2rem;
}

.score-bar-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.85rem;
  font-weight: 700;
}

.bar-track {
  flex-grow: 1;
  height: 8px;
  background: var(--bg-section-alt);
  border-radius: 4px;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
}

.score-cta-box {
  text-align: start;
}

.score-cta-box h3 {
  font-size: 1.25rem;
  color: var(--color-secondary);
  margin-bottom: 0.5rem;
}

[data-theme="dark"] .score-cta-box h3 {
  color: var(--color-accent);
}

.score-cta-box p {
  color: var(--text-secondary);
  font-size: 0.9rem;
  margin-bottom: 1.25rem;
  line-height: 1.6;
}

/* Reviews Grid */
.reviews-grid {
  gap: 2rem;
}

.review-card {
  display: flex;
  flex-direction: column;
  padding: 2rem;
}

.review-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
}

.reviewer-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--bg-section-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  border: 1px solid var(--border-color);
}

.reviewer-name {
  font-size: 1.05rem;
  font-weight: 800;
  color: var(--color-secondary);
}

[data-theme="dark"] .reviewer-name {
  color: #fff;
}

.reviewer-loc {
  font-size: 0.8rem;
  color: var(--text-muted);
}

.review-stars-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.75rem;
}

.review-date {
  font-size: 0.8rem;
  color: var(--text-muted);
}

.review-srv-tag {
  background: rgba(181, 102, 26, 0.08);
  color: var(--color-primary);
  font-size: 0.75rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 20px;
  display: inline-block;
  margin-bottom: 1rem;
  align-self: flex-start;
}

.review-comment {
  font-size: 0.95rem;
  color: var(--text-secondary);
  line-height: 1.7;
  text-align: start;
}

@media (max-width: 1024px) {
  .rating-summary-card {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .score-box, .score-bars {
    border-inline-end: none;
    padding-inline-end: 0;
  }
  .score-cta-box { text-align: center; }
  .score-cta-box .btn { margin: 0 auto; }
}

@media (max-width: 768px) {
  .review-header { justify-content: center; }
  .review-srv-tag { align-self: center; }
  .review-comment { text-align: center; }
}
</style>
