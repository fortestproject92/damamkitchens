  },
  {
    nameAr: "د. يوسف الخالدي",
    nameEn: "Dr. Yousef Al-Khaldi",
    locationAr: "سيهات، المنطقة الشرقية",
    locationEn: "Saihat, Eastern Province",
    serviceAr: "تدعيم رفوف خزائن المؤونة وتغيير المقابض",
    serviceEn: "Pantry Shelf Reinforcement & Handles",
    rating: 5,
    dateAr: "منذ شهر",
    dateEn: "1 month ago",
    commentAr: "الرفوف كانت منحنية بسبب ثقل الأواني والمواد التموينية، ركبوا دعامات زوايا حديد متينة جداً وغيروا كل المقابض لمقابض مودرن فخمة. شكراً لكم على الاحترافية العالية.",
