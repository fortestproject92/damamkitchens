---

<Layout
  title="معرض أعمالنا ونماذج الصيانة | صيانة مطابخ الدمام"
  description="شاهد بالصور نماذج حية من أعمالنا المنفذة في صيانة مطابخ الألمنيوم والخشب، تبديل المفصلات الهيدروليكية وإصلاح الأدراج في الدمام والخبر والمنطقة الشرقية."
  page="gallery"
>
  <Header slot="header" />

  <section class="page-hero" style="background-image: url('/assets/Beige Brown and White Minimalist Smart Kitchens Pitch Deck Presentation.jpg');">
    <div class="container">
      <h1 data-ar="معرض أعمال ونماذج الصيانة" data-en="Maintenance Portfolio & Project Gallery">معرض أعمال ونماذج الصيانة</h1>
      <p data-ar="نماذج حقيقية من مشاريع وأعمال صيانة المطابخ وتغيير المفصلات التي نفذناها بنجاح لعملائنا الكرام في الدمام والشرقية." data-en="Real examples of kitchen repairs and hinge upgrades successfully delivered to our clients in Dammam and Eastern Province.">
        نماذج حقيقية من مشاريع وأعمال صيانة المطابخ وتغيير المفصلات التي نفذناها بنجاح لعملائنا الكرام في الدمام والشرقية.
      </p>
    </div>
  </section>

  <!-- GALLERY SECTION -->
  <section class="section">
    <div class="container">

      <!-- Gallery Grid -->
      <div class="gallery-grid">
        {projects.map((proj) => (
          <div class="card gallery-card">
            <div class="gallery-img-box">
              <img
                src={proj.image}
                alt={proj.titleAr}
                class="gallery-photo"
                width="400"
                height="300"
                loading="lazy"
              />
              <span class="gallery-badge" data-ar={proj.tagAr} data-en={proj.tagEn}>{proj.tagAr}</span>
            </div>

            <div class="gallery-body">
              <span class="gallery-loc">📍 <span data-ar={proj.locationAr} data-en={proj.locationEn}>{proj.locationAr}</span></span>
              <h3 class="gallery-title" data-ar={proj.titleAr} data-en={proj.titleEn}>{proj.titleAr}</h3>
              <p class="gallery-desc" data-ar={proj.descAr} data-en={proj.descEn}>{proj.descAr}</p>
              
              <div class="gallery-card-action">
                <a
                  href={`https://wa.me/966552854516?text=${encodeURIComponent(`مرحباً، أرغب في تنفيذ صيانة مشابهة لعمل: ${proj.titleAr}`)}`}
                  class="btn btn-whatsapp gallery-btn"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="طلب عمل مشابه"
                >
                  <span>💬</span>
                  <span data-ar="طلب صيانة مماثلة" data-en="Request Similar Service">طلب صيانة مماثلة</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Bottom Trust Note -->
      <div class="gallery-note card">
        <h3 data-ar="هل يعاني مطبخك من أي مشكلة مشابهة؟" data-en="Is your kitchen suffering from a similar issue?">هل يعاني مطبخك من أي مشكلة مشابهة؟</h3>
        <p data-ar="أرسل لنا صورة المشكلة على الواتساب وسيقوم الفني بتشخيصها فوراً وتحديد القطع المطلوبة لحلها في زيارة واحدة." data-en="Send us a photo of the problem on WhatsApp, and our technician will diagnose it and arrive with the exact parts.">
          أرسل لنا صورة المشكلة على الواتساب وسيقوم الفني بتشخيصها فوراً وتحديد القطع المطلوبة لحلها في زيارة واحدة.
        </p>
        <div class="gallery-note-actions">
          <a href="https://wa.me/966552854516?text=مرحباً، أود إرسال صورة عطل المطبخ للمعاينة" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg">
            <span>📸</span>
            <span data-ar="أرسل صورة العطل عبر واتساب" data-en="Send Photo via WhatsApp">أرسل صورة العطل عبر واتساب</span>
          </a>
          <a href="tel:+966552854516" class="btn btn-secondary btn-lg">
            <span>📞</span>
            <span data-ar="اتصل الآن: 0552854516" data-en="Call Now: 0552854516">اتصل الآن: 0552854516</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <FloatingCTA />
  <Footer slot="footer" />
</Layout>

<style>
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin-bottom: 4rem;
}

.gallery-card {
  padding: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.gallery-img-box {
  position: relative;
  width: 100%;
  height: 250px;
  background: var(--color-secondary);
  overflow: hidden;
}

.gallery-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.gallery-card:hover .gallery-photo {
  transform: scale(1.06);
}

.gallery-badge {
  position: absolute;
  top: 1rem;
  inset-inline-end: 1rem;
  background: rgba(182, 123, 89, 0.92);
  color: #fff;
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 700;
  box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}

.gallery-body {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.gallery-loc {
  font-size: 0.8rem;
  color: var(--color-primary);
  font-weight: 700;
  margin-bottom: 0.5rem;
}

.gallery-title {
  font-size: 1.15rem;
  color: var(--color-secondary);
  margin-bottom: 0.75rem;
  line-height: 1.4;
}

[data-theme="dark"] .gallery-title {
  color: var(--color-accent);
}

.gallery-desc {
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 1.25rem;
  flex-grow: 1;
  text-align: start;
}

.gallery-btn {
  width: 100%;
  justify-content: center;
  font-size: 0.85rem;
  padding: 0.6rem 1rem;
}

.gallery-note {
  text-align: center;
  padding: 3rem 2rem;
  background: linear-gradient(135deg, rgba(58,37,32,0.06), rgba(182,123,89,0.06));
  border: 2px dashed var(--color-primary);
}

.gallery-note h3 {
  font-size: 1.6rem;
  color: var(--color-secondary);
  margin-bottom: 0.75rem;
}

[data-theme="dark"] .gallery-note h3 {
  color: var(--color-accent);
}

.gallery-note p {
  color: var(--text-secondary);
  font-size: 1.05rem;
  max-width: 650px;
  margin: 0 auto 2rem;
  line-height: 1.7;
}

.gallery-note-actions {
  display: flex;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
}

@media (max-width: 1024px) {
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  .gallery-grid { grid-template-columns: 1fr; }
  .gallery-desc { text-align: center; }
}
</style>
