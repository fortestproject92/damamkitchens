---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import IdentityCard from '../../components/IdentityCard.astro';

const siteUrl = 'https://www.damamkitchens.com';
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "إصلاح وتغيير مفصلات وسحابات الأدراج",
  "serviceType": "إصلاح وتغيير مفصلات وسحابات الأدراج",
  "description": "استبدال المفصلات الهيدروليكية وسكك الأدراج بالدمام بقطع إيطالية وألمانية: سوفت كلوز، رولمان بلي، وضبط دقيق للأبواب.",
  "areaServed": [
    { "@type": "City", "name": "الدمام" },
    { "@type": "City", "name": "الخبر" },
    { "@type": "City", "name": "الظهران" },
    { "@type": "City", "name": "القطيف" },
    { "@type": "City", "name": "الجبيل" }
  ],
  "provider": {
    "@type": "HomeAndConstructionBusiness",
    "name": "فني مطابخ وصيانة مطابخ بالدمام",
    "telephone": "+966552854516",
    "url": siteUrl,
    "image": siteUrl + "/img/logo-mark-360.jpg"
  },
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "areaServed": "الدمام، المنطقة الشرقية"
  },
  "url": siteUrl + "/services/hinges-drawer-slides/"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "خدماتنا", "item": siteUrl + "/services/" },
    { "@type": "ListItem", "position": 3, "name": "إصلاح وتغيير مفصلات وسحابات الأدراج", "item": siteUrl + "/services/hinges-drawer-slides/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
        {
      "@type": "Question",
      "name": "كيف أعرف أن المفصلة تحتاج استبدالًا أم ضبطًا؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "إذا كان الباب يغلق ولا يصدر صوتًا لكنه مائل قليلًا، فالضبط كافٍ غالبًا. إذا كان الباب لا يبقى مغلقًا، أو يصفق، أو الباب منخفض بشكل واضح، فالمفصلة تالفة. الفحص لا يتجاوز دقائق."
      }
    },
    {
      "@type": "Question",
      "name": "كم عدد المفصلات لكل باب؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "الأبواب العادية مفصلتان، والأبواب الطويلة أو الثقيلة تحتاج ثلاث مفصلات على الأقل. الباب بأقل من العدد المناسب يتوزع وزنه على مفصلة واحدة فيتلف أسرع."
      }
    },
    {
      "@type": "Question",
      "name": "ما الفرق بين السوفت كلوز والعادي؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "السوفت كلوز يحتوي على صمام هيدروليك يبطئ الباب في آخر 15 درجة، فيغلق بهدوء دون تصفيق. العادي يُغلق بالجاذبية والسرعة. السوفت كلوز يحمي الباب والوحدة من الصدمات المتكررة."
      }
    },
    {
      "@type": "Question",
      "name": "لماذا تصدأ المفصلات في الدمام؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "رطوبة المنطقة الشرقية العالية تُسرّع أكسدة المعادن الرخيصة. المفصلة المصنوعة من سبيكة مقاومة للصدأ (غالبًا ستانلس ستيل 304) تبقى سنوات، أما الحديد المطلي فتتآكل طبقته بعد أشهر."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكن استبدال سكة الدرج بسكة أطول؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، بشرط أن يتحمل عمق الدرج الطول الإضافي ولا يصطدم بجدار أو وحدة أخرى خلفه. نقيس المساحة خلف الدرج قبل الاختيار."
      }
    }
  ]
};
---

<Layout
  title="تغيير مفصلات وسحابات الأدراج بالدمام | هيدروليك سوفت كلوز 0552854516"
  description="استبدال المفصلات الهيدروليكية وسكك الأدراج بالدمام بقطع إيطالية وألمانية: سوفت كلوز، رولمان بلي، وضبط دقيق للأبواب."
  page="services"
  ogImage="/img/kitchen-project-01-1400.jpg"
  ogImageWidth={1400}
  ogImageHeight={788}
>
  <Header slot="header" />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="page-hero" style="background-image: url('/img/kitchen-project-01-1400.jpg');">
    <div class="container">
      <nav class="crumbs" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a> / <a href="/services/">خدماتنا</a> / <span>إصلاح وتغيير مفصلات وسحابات الأدراج</span>
      </nav>
      <h1>إصلاح وتغيير مفصلات وسحابات الأدراج بالدمام</h1>
      <p>المفصلة الصغيرة تحمل وزن الباب كله عشرات المرات في اليوم. عندما تضعف، لا يسقط الباب فورًا — يبدأ بميل بسيط، ثم يصطدم بالجار، ثم يتفتت الخشب حوله.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
            <p>المفصلة هي أكثر قطعة تُطلب في صيانة المطابخ، وهي أكثر قطعة يُخطئ فيها الناس. استبدال مفصلة بآخرى رخيصة يبدو حلًا، لكن المفصلة الرديئة تفقد ضغط الهيدروليك في أشهر، فيبدأ الباب بالسقوط على الجار، وتتكرر المشكلة قبل أن ينتهي الموسم.</p>
      <p>الفرق الحقيقي في قطع الغيار. المفصلة الجيدة تحمل تصنيف دورات فتح وإغلاق مُقاس، ومحورها من سبيكة مقاومة للصدأ، ونابضها محسوب لوزن الباب. المفصلة الرديئة لا تحمل أي تصنيف، وتُباع بسعر يخفي أنها ستُستبدل بعد أشهر. في مطبخ بالدمام الرطوبة عالية، فالمعدن الرخيص يصدأ بسرعة أكبر، والصدأ هو القاتل الصامت للمحور.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">علامات تحتاج فيها هذه الخدمة</h2>
        <p class="section-subtitle">أعراض شائعة نراها في مطابخ الدمام — كل عرض له سبب مختلف وعلاج مختلف.</p>
      </div>
      <div class="grid-3">
                <div class="card sym-card">
          <span class="sym-icon">🚪</span>
          <h3>باب لا يبقى مغلقًا</h3>
          <p>النابض فقد ضغطه. الاستبدال هو الحل الوحيد، لا الشد. المفصلة المرتخية تُستهلك بسرعة أكبر بعد كل شد.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">💥</span>
          <h3>الباب يصفق عند الإغلاق</h3>
          <p>خلل في صمام الهيدروليك. المفصلة السوفت كلوز تُغلق ببطء في آخر 15 درجة، وصفير التصفيق يعني أن هذا الصمام تلف.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">📐</span>
          <h3>فراغ غير متساوٍ بين الأبواب</h3>
          <p>ليس عيبًا في المفصلة بالضرورة. قد يكون ضبطًا بسيطًا لبرغيي التعديل × و Y. نجرّب الضبط قبل التغيير.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">🪵</span>
          <h3>خشب متفتت حول المفصلة</h3>
          <p>المسامير لم تعد تُمسك. الحل محشوّة خشبية ومسامير أطول، أو نقل المفصلة لموقع جديد سليم.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">🎚️</span>
          <h3>درج يخرج بسرعة أو يعلق</h3>
          <p>سكة تالفة أو غير موازية. الدرج المائل يُستهلك رولمانه أسرع من الدرج المستقيم.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">🔊</span>
          <h3>صوت خشن من الدرج</h3>
          <p>تآكل الرولمان. التشحيم مؤقت، والاستبدال هو الحل الدائم.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">كيف نعمل — أربع مراحل واضحة</h2>
        <p class="section-subtitle">لا أعمال إضافية دون موافقتك، ولا تسعير غير مكتوب.</p>
      </div>
      <div class="grid-4">
                <div class="card step-card">
          <span class="step-num">1</span>
          <h3>تحديد الأعراض</h3>
          <p>نميّز بين خلل الضبط وخلل القطعة. نحو 30 بالمئة من الحالات تُحل بضبط المفصلة دون استبدال.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">2</span>
          <h3>اختيار القطعة</h3>
          <p>نوع المفصلة حسب وزن الباب وسمك المادة: مفصلة كاملة التراكب، نصف تراكب، أو زاوية 165 للزوايا الضيقة.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">3</span>
          <h3>التركيب</h3>
          <p>استبدال المفصلة أو السكة مع الحفاظ على مواقع الثقوب الأصلية حيث أمكن، أو إغلاق الثقوب القديمة قبل التثبيت الجديد.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">4</span>
          <h3>اختبار الحمل</h3>
          <p>فتح وإغلاق متكرر مع اختبار الحمل الفعلي لضمان ثبات الباب وسلاسة السحب.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="grid-2 split">
        <div>
          <h2 class="section-title">ماذا يشمل العمل</h2>
          <ul class="checklist">
                        <li>مفصلات هيدروليك إيطالية وألمانية بضمان دورات مُصنّف</li>
            <li>سكك أدراج رولمان بلي كامل الامتداد أو نصف امتداد</li>
            <li>ضبط دقيق لزوايا المفصلة الثلاثية (X, Y, وعمق)</li>
            <li>إغلاق الثقوب القديمة وحشو الخشب المتففت قبل التثبيت</li>
            <li>نقل المفصلة إلى موقع سليم عند تلف موقع التثبيت</li>
            <li>معالجة الصدأ الموجود قبل تركيب القطعة الجديدة</li>
            <li>اختبار حمل نهائي لكل باب ودرج</li>
          </ul>
        </div>
        <div class="split-media">
          <picture>
            <source type="image/webp" srcset="/img/kitchen-project-01-1400.webp 1400w, /img/kitchen-project-01-900.webp 900w, /img/kitchen-project-01-600.webp 600w, /img/kitchen-project-01-400.webp 400w" sizes="(max-width: 640px) 92vw, 46vw" />
            <img src="/img/kitchen-project-01-900.jpg" srcset="/img/kitchen-project-01-1400.jpg 1400w, /img/kitchen-project-01-900.jpg 900w, /img/kitchen-project-01-600.jpg 600w, /img/kitchen-project-01-400.jpg 400w" sizes="(max-width: 640px) 92vw, 46vw" alt="إصلاح وتغيير مفصلات وسحابات الأدراج بالدمام" width="600" height="600" loading="lazy" decoding="async" class="split-img card" />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">أسئلة يتكرر طرحها</h2>
        <p class="section-subtitle">أجوبة مباشرة على ما يسأل عنه العملاء قبل الحجز.</p>
      </div>
      <div class="faq-list">
                <div class="faq-item">
          <button class="faq-q" aria-expanded="false">كيف أعرف أن المفصلة تحتاج استبدالًا أم ضبطًا؟</button>
          <div class="faq-a"><p>إذا كان الباب يغلق ولا يصدر صوتًا لكنه مائل قليلًا، فالضبط كافٍ غالبًا. إذا كان الباب لا يبقى مغلقًا، أو يصفق، أو الباب منخفض بشكل واضح، فالمفصلة تالفة. الفحص لا يتجاوز دقائق.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">كم عدد المفصلات لكل باب؟</button>
          <div class="faq-a"><p>الأبواب العادية مفصلتان، والأبواب الطويلة أو الثقيلة تحتاج ثلاث مفصلات على الأقل. الباب بأقل من العدد المناسب يتوزع وزنه على مفصلة واحدة فيتلف أسرع.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">ما الفرق بين السوفت كلوز والعادي؟</button>
          <div class="faq-a"><p>السوفت كلوز يحتوي على صمام هيدروليك يبطئ الباب في آخر 15 درجة، فيغلق بهدوء دون تصفيق. العادي يُغلق بالجاذبية والسرعة. السوفت كلوز يحمي الباب والوحدة من الصدمات المتكررة.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">لماذا تصدأ المفصلات في الدمام؟</button>
          <div class="faq-a"><p>رطوبة المنطقة الشرقية العالية تُسرّع أكسدة المعادن الرخيصة. المفصلة المصنوعة من سبيكة مقاومة للصدأ (غالبًا ستانلس ستيل 304) تبقى سنوات، أما الحديد المطلي فتتآكل طبقته بعد أشهر.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">هل يمكن استبدال سكة الدرج بسكة أطول؟</button>
          <div class="faq-a"><p>نعم، بشرط أن يتحمل عمق الدرج الطول الإضافي ولا يصطدم بجدار أو وحدة أخرى خلفه. نقيس المساحة خلف الدرج قبل الاختيار.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">خدمات أخرى قد تحتاجها</h2>
      </div>
      <div class="other-services">
                <a href="/services/kitchen-maintenance/">صيانة مطابخ</a>
        <a href="/services/kitchen-moving-installation/">فك وتركيب ونقل مطابخ</a>
        <a href="/services/kitchen-resizing-carpentry/">تعديل وقص وتفصيل</a>
        <a href="/services/kitchen-marble/">رخام المطابخ</a>
        <a href="/services/ikea-ready-kitchens/">مطابخ إيكيا والجاهزة</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-box">
        <h2>تحتاج إصلاح وتغيير مفصلات وسحابات الأدراج في الدمام؟</h2>
        <p>اتصل أو أرسل صورة للمشكلة على واتساب، وسنعطيك تقديرًا واضحًا قبل الحضور.</p>
        <div class="cta-btns">
          <a href="tel:+966552854516" class="btn btn-primary btn-lg">📞 0552854516</a>
          <a href="https://wa.me/966552854516?text=مرحباً، أحتاج إصلاح وتغيير مفصلات وسحابات الأدراج بالدمام" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">💬 واتساب</a>
        </div>
      </div>
    </div>
  </section>

  <IdentityCard />
  <FloatingCTA />
  <Footer slot="footer" />
</Layout>

<style>
.crumbs { font-size: .875rem; color: rgba(255,255,255,.75); margin-bottom: 1rem; }
.crumbs a { color: rgba(255,255,255,.9); text-decoration: underline; text-underline-offset: 3px; }
.crumbs span { color: #fff; font-weight: 700; }

.prose { max-width: 820px; margin: 0 auto; }
.prose p { color: var(--text-secondary); line-height: 1.95; font-size: 1.06rem; margin-bottom: 1.4rem; text-align: start; }

.sym-card { text-align: start; }
.sym-icon { font-size: 2rem; margin-bottom: .75rem; display: block; }
.sym-card h3 { color: var(--color-secondary); font-size: 1.1rem; margin-bottom: .6rem; }
[data-theme="dark"] .sym-card h3 { color: var(--color-accent); }
.sym-card p { color: var(--text-secondary); line-height: 1.75; font-size: .95rem; }

.step-card { position: relative; padding-top: 2.5rem; }
.step-num { position: absolute; top: 1rem; inset-inline-start: 1.2rem; width: 2rem; height: 2rem; border-radius: 50%; background: var(--color-primary); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: .9rem; }
.step-card h3 { font-size: 1.02rem; margin-bottom: .55rem; color: var(--color-secondary); }
[data-theme="dark"] .step-card h3 { color: var(--color-accent); }
.step-card p { color: var(--text-secondary); line-height: 1.7; font-size: .93rem; }

.split { align-items: center; gap: 2.5rem; }
.split-img { width: 100%; height: auto; display: block; object-fit: cover; padding: 0; }
.checklist { list-style: none; padding: 0; margin: 1.5rem 0 0; }
.checklist li { position: relative; padding-inline-start: 1.9rem; margin-bottom: .85rem; color: var(--text-secondary); line-height: 1.7; }
.checklist li::before { content: "✓"; position: absolute; inset-inline-start: 0; top: 0; width: 1.3rem; height: 1.3rem; border-radius: 50%; background: var(--color-primary); color: #fff; display: grid; place-items: center; font-size: .72rem; font-weight: 900; }

.faq-list { max-width: 860px; margin: 0 auto; }
.faq-item { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--border-radius); margin-bottom: .9rem; overflow: hidden; }
.faq-q { width: 100%; text-align: start; background: none; border: 0; padding: 1.15rem 1.3rem; font-family: inherit; font-size: 1rem; font-weight: 700; color: var(--text-primary); cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
.faq-q::after { content: "+"; font-size: 1.4rem; color: var(--color-primary); flex-shrink: 0; transition: transform .3s; }
.faq-item.open .faq-q::after { transform: rotate(45deg); }
.faq-a { max-height: 0; overflow: hidden; transition: max-height .35s ease; }
.faq-item.open .faq-a { max-height: 500px; }
.faq-a p { padding: 0 1.3rem 1.2rem; color: var(--text-secondary); line-height: 1.85; margin: 0; }

.other-services { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; }
.other-services a { background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); padding: .7rem 1.3rem; border-radius: 100px; text-decoration: none; font-weight: 600; font-size: .92rem; transition: var(--transition); }
.other-services a:hover { background: var(--color-primary); color: #fff; border-color: var(--color-primary); transform: translateY(-2px); }

.cta-box { background: var(--bg-section-alt); border-radius: var(--border-radius-xl); padding: 3rem 2rem; text-align: center; border: 1px solid var(--border-color); }
.cta-box h2 { font-size: 1.7rem; margin-bottom: .8rem; color: var(--color-secondary); }
[data-theme="dark"] .cta-box h2 { color: var(--color-accent); }
.cta-box p { color: var(--text-secondary); margin-bottom: 1.6rem; line-height: 1.7; }
.cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

@media (max-width: 768px) {
  .prose p { text-align: center; }
}
</style>

<script>
  document.querySelectorAll('.faq-q').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const open = item.classList.contains('open');
      item.parentElement.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
      if (!open) item.classList.add('open');
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
</script>
