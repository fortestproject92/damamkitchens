---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import IdentityCard from '../../components/IdentityCard.astro';

const siteUrl = 'https://www.damamkitchens.com';
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "تركيب وصيانة مطابخ إيكيا والجاهزة",
  "serviceType": "تركيب وصيانة مطابخ إيكيا والجاهزة",
  "description": "تركيب وصيانة مطابخ إيكيا والمطابخ الجاهزة بالدمام: تجميع الوحدات، تثبيت الجدران، ضبط الأدراج والمفصلات، وتغطية نقص القطع.",
  "areaServed": [
    { "@type": "City", "name": "الدمام" },
    { "@type": "City", "name": "الخبر" },
    { "@type": "City", "name": "الظهران" },
    { "@type": "City", "name": "القطيف" },
    { "@type": "City", "name": "الجبيل" }
  ],
  "provider": {
    "@type": "HomeAndConstructionBusiness",
    "name": "فني مطابخ وصيانة مطابخ بالدمام",
    "telephone": "+966552854516",
    "url": siteUrl,
    "image": siteUrl + "/img/logo-mark-360.jpg"
  },
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "areaServed": "الدمام، المنطقة الشرقية"
  },
  "url": siteUrl + "/services/ikea-ready-kitchens/"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "خدماتنا", "item": siteUrl + "/services/" },
    { "@type": "ListItem", "position": 3, "name": "تركيب وصيانة مطابخ إيكيا والجاهزة", "item": siteUrl + "/services/ikea-ready-kitchens/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
        {
      "@type": "Question",
      "name": "هل تركيب مطبخ إيكيا أصعب من المطابخ العادية؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ليس أصعب لكنه أكثر حرجًا. النظام مصمم ليتجمع بترتيب محدد، وتجاوز الخطوة الأولى يجعل الخطوات التالية غير ممكنة. لهذا نبدأ دائمًا بتحديد الوحدة الحاملة وقضيب التعليق."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكن تعديل مطبخ إيكيا القائم؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، لكن مطابخ إيكيا تعتمد على نظام تثبيت خاص ومقاسات معيارية. التعديل ممكن باستخدام قطع من نفس النظام أو بدائل متوافقة. نوضح التكلفة والبدائل قبل البدء."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكن تركيب مطبخ إيكيا على جدار جبس؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ليس مباشرة. يحتاج الأمر إلى تدعيم الجدار بقضيب خشبي أو معدني مثبت في الجدار الحقيقي، ثم تثبيت قضيب التعليق فيه. التثبيت المباشر على الجبس يسقط بعد أشهر."
      }
    },
    {
      "@type": "Question",
      "name": "كيف أعرف أن المطبخ يحتاج ضبطًا أم استبدال قطعة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "إذا كانت الأعراض ميلًا بسيطًا أو درجًا يعض عند الفتح، فالضبط كافٍ. أما إذا كان الباب مرتخيًا أو الدرج يخرج من مجراه، فالقطعة تالفة. الفحص يكشف ذلك في دقائق."
      }
    },
    {
      "@type": "Question",
      "name": "هل توفرون قطع غيار مطابخ إيكيا؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نوفر المفصلات والسكك والمشابك المتوفرة عند التجزئة، وغالبًا هذه هي القطع التي تتلف. إذا احتجت قطعة من نظام إيكيا محدد، نساعد في تحديد رقمها لتطلبها."
      }
    }
  ]
};
---

<Layout
  title="تركيب وصيانة مطابخ إيكيا والجاهزة بالدمام | فني متخصص 0552854516"
  description="تركيب وصيانة مطابخ إيكيا والمطابخ الجاهزة بالدمام: تجميع الوحدات، تثبيت الجدران، ضبط الأدراج والمفصلات، وتغطية نقص القطع."
  page="services"
  ogImage="/img/kitchen-project-12-1400.jpg"
  ogImageWidth={1400}
  ogImageHeight={788}
>
  <Header slot="header" />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="page-hero" style="background-image: url('/img/kitchen-project-12-1400.jpg');">
    <div class="container">
      <nav class="crumbs" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a> / <a href="/services/">خدماتنا</a> / <span>تركيب وصيانة مطابخ إيكيا والجاهزة</span>
      </nav>
      <h1>تركيب وصيانة مطابخ إيكيا والمطابخ الجاهزة بالدمام</h1>
      <p>المطبخ الجاهز ليس قطعًا يمكن تجميعها بالحدس. نظام تثبيته له منطق خاص، وتجاوز الخطوة الأولى يجعل الخطوات التالية غير ممكنة.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
            <p>المطابخ الجاهزة — إيكيا وغيرها من الأنظمة المعيارية — تعمل بنظام تثبيت موحّد: قضيب تعليق على الجدار، وحدة حاملة، وأدراج تُثبّت مغناطيسيًا أو بمشابك. هذه الأنظمة مصممة لتُجمّع بترتيب محدد. إذا بدأ التجميع بالوحدة الخطأ، ستنحرف الشبكة كلها، ولن تستقيم الأدراج مهما ضُبطت.</p>
      <p>الأخطاء التي نراها بكثرة: وحدة مثبتة مباشرة على الجدار دون قضيب التعليق (فتتفتت مواقع المسامير بعد أشهر)، وأدراج لم تُثبّت مشابكها على السكة، وأبواب لم تُضبط بعد التركيب فتبدو مائلة. هذه ليست عيوب تصنيع — هي أخطاء تركيب تُصلح بالطريقة الصحيحة في زيارة واحدة.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">علامات تحتاج فيها هذه الخدمة</h2>
        <p class="section-subtitle">أعراض شائعة نراها في مطابخ الدمام — كل عرض له سبب مختلف وعلاج مختلف.</p>
      </div>
      <div class="grid-3">
                <div class="card sym-card">
          <span class="sym-icon">📦</span>
          <h3>تجميع النظام الصحيح</h3>
          <p>تحديد الوحدة الحاملة أولًا، ثم تثبيت قضيب التعليق، ثم تعليق الوحدات بترتيبها. الخطأ في البداية يُفسد كل ما بعده.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">🔩</span>
          <h3>تثبيت الجدار المناسب</h3>
          <p>لكل نوع جدار مثبت خاص: طوب، خرسانة، أو جبس. الحسافة والنوع الخاطئ يسبب سقوط الوحدة.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">🎚️</span>
          <h3>ضبط الأدراج</h3>
          <p>الأدراج في الأنظمة المعيارية تحتاج ضبط مشابك على السكة. بدون هذا، يُسحب الدرج بشكل مائل ويستهلك رولمانه.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">🚪</span>
          <h3>ضبط الأبواب</h3>
          <p>المفصلات لها ثلاثة براغي تعديل. الضبط بالمليمتر يجعل الفواصل متساوية.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">🧩</span>
          <h3>تغطية نقص القطع</h3>
          <p>القطع التالفة أو المفقودة يمكن استبدالها من النظام نفسه أو ببديل متوافق.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">🔧</span>
          <h3>صيانة ما بعد التركيب</h3>
          <p>إعادة ضبط، استبدال قطعة تالفة، أو إصلاح تثبيت انتهى بسبب الاستخدام.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">كيف نعمل — أربع مراحل واضحة</h2>
        <p class="section-subtitle">لا أعمال إضافية دون موافقتك، ولا تسعير غير مكتوب.</p>
      </div>
      <div class="grid-4">
                <div class="card step-card">
          <span class="step-num">1</span>
          <h3>مراجعة القطع</h3>
          <p>فحص الوحدات والقطع والمشابك قبل البدء، والتأكد من اكتمال العدد ومطابقة النظام.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">2</span>
          <h3>تحديد النظام</h3>
          <p>معرفة نظام التعليق الخاص بالمطبخ: قضيب، أو أكواب تعليق، أو براغي مباشرة حسب النظام.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">3</span>
          <h3>التثبيت بالتسلسل</h3>
          <p>وحدة حاملة، قضيب، ثم تعليق الوحدات بترتيبها الأصلي مع فحص الاستواء في كل خطوة.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">4</span>
          <h3>الضبط النهائي</h3>
          <p>ضبط جميع الأدراج والمفصلات والفواصل، واختبار فتح وإغلاق كل عنصر.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="grid-2 split">
        <div>
          <h2 class="section-title">ماذا يشمل العمل</h2>
          <ul class="checklist">
                        <li>تجميع وحدات إيكيا وأنظمة المطابخ الجاهزة بترتيبها الصحيح</li>
            <li>تثبيت قضيب التعليق بمثبتات مناسبة لنوع الجدار</li>
            <li>ضبط مشابك الأدراج على السكة لمنع السحب المائل</li>
            <li>ضبط المفصلات الثلاثية لمواءمة الفواصل</li>
            <li>استبدال أو تغطية القطع التالفة أو الناقصة</li>
            <li>إصلاح التثبيت المنحل بعد أشهر من التركيب</li>
            <li>فحص أيضًا استواء الشبكة عند تسليم العمل</li>
          </ul>
        </div>
        <div class="split-media">
          <picture>
            <source type="image/webp" srcset="/img/kitchen-project-12-1400.webp 1400w, /img/kitchen-project-12-900.webp 900w, /img/kitchen-project-12-600.webp 600w, /img/kitchen-project-12-400.webp 400w" sizes="(max-width: 640px) 92vw, 46vw" />
            <img src="/img/kitchen-project-12-900.jpg" srcset="/img/kitchen-project-12-1400.jpg 1400w, /img/kitchen-project-12-900.jpg 900w, /img/kitchen-project-12-600.jpg 600w, /img/kitchen-project-12-400.jpg 400w" sizes="(max-width: 640px) 92vw, 46vw" alt="تركيب وصيانة مطابخ إيكيا والجاهزة بالدمام" width="600" height="600" loading="lazy" decoding="async" class="split-img card" />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">أسئلة يتكرر طرحها</h2>
        <p class="section-subtitle">أجوبة مباشرة على ما يسأل عنه العملاء قبل الحجز.</p>
      </div>
      <div class="faq-list">
                <div class="faq-item">
          <button class="faq-q" aria-expanded="false">هل تركيب مطبخ إيكيا أصعب من المطابخ العادية؟</button>
          <div class="faq-a"><p>ليس أصعب لكنه أكثر حرجًا. النظام مصمم ليتجمع بترتيب محدد، وتجاوز الخطوة الأولى يجعل الخطوات التالية غير ممكنة. لهذا نبدأ دائمًا بتحديد الوحدة الحاملة وقضيب التعليق.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">هل يمكن تعديل مطبخ إيكيا القائم؟</button>
          <div class="faq-a"><p>نعم، لكن مطابخ إيكيا تعتمد على نظام تثبيت خاص ومقاسات معيارية. التعديل ممكن باستخدام قطع من نفس النظام أو بدائل متوافقة. نوضح التكلفة والبدائل قبل البدء.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">هل يمكن تركيب مطبخ إيكيا على جدار جبس؟</button>
          <div class="faq-a"><p>ليس مباشرة. يحتاج الأمر إلى تدعيم الجدار بقضيب خشبي أو معدني مثبت في الجدار الحقيقي، ثم تثبيت قضيب التعليق فيه. التثبيت المباشر على الجبس يسقط بعد أشهر.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">كيف أعرف أن المطبخ يحتاج ضبطًا أم استبدال قطعة؟</button>
          <div class="faq-a"><p>إذا كانت الأعراض ميلًا بسيطًا أو درجًا يعض عند الفتح، فالضبط كافٍ. أما إذا كان الباب مرتخيًا أو الدرج يخرج من مجراه، فالقطعة تالفة. الفحص يكشف ذلك في دقائق.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">هل توفرون قطع غيار مطابخ إيكيا؟</button>
          <div class="faq-a"><p>نوفر المفصلات والسكك والمشابك المتوفرة عند التجزئة، وغالبًا هذه هي القطع التي تتلف. إذا احتجت قطعة من نظام إيكيا محدد، نساعد في تحديد رقمها لتطلبها.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">خدمات أخرى قد تحتاجها</h2>
      </div>
      <div class="other-services">
                <a href="/services/kitchen-maintenance/">صيانة مطابخ</a>
        <a href="/services/kitchen-moving-installation/">فك وتركيب ونقل مطابخ</a>
        <a href="/services/kitchen-resizing-carpentry/">تعديل وقص وتفصيل</a>
        <a href="/services/hinges-drawer-slides/">مفصلات وسحابات الأدراج</a>
        <a href="/services/kitchen-marble/">رخام المطابخ</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-box">
        <h2>تحتاج تركيب وصيانة مطابخ إيكيا والجاهزة في الدمام؟</h2>
        <p>اتصل أو أرسل صورة للمشكلة على واتساب، وسنعطيك تقديرًا واضحًا قبل الحضور.</p>
        <div class="cta-btns">
          <a href="tel:+966552854516" class="btn btn-primary btn-lg">📞 0552854516</a>
          <a href="https://wa.me/966552854516?text=مرحباً، أحتاج تركيب وصيانة مطابخ إيكيا والجاهزة بالدمام" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">💬 واتساب</a>
        </div>
      </div>
    </div>
  </section>

  <IdentityCard />
  <FloatingCTA />
  <Footer slot="footer" />
</Layout>

<style>
.crumbs { font-size: .875rem; color: rgba(255,255,255,.75); margin-bottom: 1rem; }
.crumbs a { color: rgba(255,255,255,.9); text-decoration: underline; text-underline-offset: 3px; }
.crumbs span { color: #fff; font-weight: 700; }

.prose { max-width: 820px; margin: 0 auto; }
.prose p { color: var(--text-secondary); line-height: 1.95; font-size: 1.06rem; margin-bottom: 1.4rem; text-align: start; }

.sym-card { text-align: start; }
.sym-icon { font-size: 2rem; margin-bottom: .75rem; display: block; }
.sym-card h3 { color: var(--color-secondary); font-size: 1.1rem; margin-bottom: .6rem; }
[data-theme="dark"] .sym-card h3 { color: var(--color-accent); }
.sym-card p { color: var(--text-secondary); line-height: 1.75; font-size: .95rem; }

.step-card { position: relative; padding-top: 2.5rem; }
.step-num { position: absolute; top: 1rem; inset-inline-start: 1.2rem; width: 2rem; height: 2rem; border-radius: 50%; background: var(--color-primary); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: .9rem; }
.step-card h3 { font-size: 1.02rem; margin-bottom: .55rem; color: var(--color-secondary); }
[data-theme="dark"] .step-card h3 { color: var(--color-accent); }
.step-card p { color: var(--text-secondary); line-height: 1.7; font-size: .93rem; }

.split { align-items: center; gap: 2.5rem; }
.split-img { width: 100%; height: auto; display: block; object-fit: cover; padding: 0; }
.checklist { list-style: none; padding: 0; margin: 1.5rem 0 0; }
.checklist li { position: relative; padding-inline-start: 1.9rem; margin-bottom: .85rem; color: var(--text-secondary); line-height: 1.7; }
.checklist li::before { content: "✓"; position: absolute; inset-inline-start: 0; top: 0; width: 1.3rem; height: 1.3rem; border-radius: 50%; background: var(--color-primary); color: #fff; display: grid; place-items: center; font-size: .72rem; font-weight: 900; }

.faq-list { max-width: 860px; margin: 0 auto; }
.faq-item { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--border-radius); margin-bottom: .9rem; overflow: hidden; }
.faq-q { width: 100%; text-align: start; background: none; border: 0; padding: 1.15rem 1.3rem; font-family: inherit; font-size: 1rem; font-weight: 700; color: var(--text-primary); cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
.faq-q::after { content: "+"; font-size: 1.4rem; color: var(--color-primary); flex-shrink: 0; transition: transform .3s; }
.faq-item.open .faq-q::after { transform: rotate(45deg); }
.faq-a { max-height: 0; overflow: hidden; transition: max-height .35s ease; }
.faq-item.open .faq-a { max-height: 500px; }
.faq-a p { padding: 0 1.3rem 1.2rem; color: var(--text-secondary); line-height: 1.85; margin: 0; }

.other-services { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; }
.other-services a { background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); padding: .7rem 1.3rem; border-radius: 100px; text-decoration: none; font-weight: 600; font-size: .92rem; transition: var(--transition); }
.other-services a:hover { background: var(--color-primary); color: #fff; border-color: var(--color-primary); transform: translateY(-2px); }

.cta-box { background: var(--bg-section-alt); border-radius: var(--border-radius-xl); padding: 3rem 2rem; text-align: center; border: 1px solid var(--border-color); }
.cta-box h2 { font-size: 1.7rem; margin-bottom: .8rem; color: var(--color-secondary); }
[data-theme="dark"] .cta-box h2 { color: var(--color-accent); }
.cta-box p { color: var(--text-secondary); margin-bottom: 1.6rem; line-height: 1.7; }
.cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

@media (max-width: 768px) {
  .prose p { text-align: center; }
}
</style>

<script>
  document.querySelectorAll('.faq-q').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const open = item.classList.contains('open');
      item.parentElement.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
      if (!open) item.classList.add('open');
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
</script>
