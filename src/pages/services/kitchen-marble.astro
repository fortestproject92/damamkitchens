---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import IdentityCard from '../../components/IdentityCard.astro';

const siteUrl = 'https://www.damamkitchens.com';
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "تغيير وصيانة رخام المطابخ",
  "serviceType": "تغيير وصيانة رخام المطابخ",
  "description": "تغيير وصيانة رخام المطابخ بالدمام: معالجة الشروخ، تلميع الرخام الصناعي والطبيعي، تبديل المجالي، وتفصيل أحواض جديدة.",
  "areaServed": [
    { "@type": "City", "name": "الدمام" },
    { "@type": "City", "name": "الخبر" },
    { "@type": "City", "name": "الظهران" },
    { "@type": "City", "name": "القطيف" },
    { "@type": "City", "name": "الجبيل" }
  ],
  "provider": {
    "@type": "HomeAndConstructionBusiness",
    "name": "فني مطابخ وصيانة مطابخ بالدمام",
    "telephone": "+966552854516",
    "url": siteUrl,
    "image": siteUrl + "/img/logo-mark-360.jpg"
  },
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "areaServed": "الدمام، المنطقة الشرقية"
  },
  "url": siteUrl + "/services/kitchen-marble/"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "خدماتنا", "item": siteUrl + "/services/" },
    { "@type": "ListItem", "position": 3, "name": "تغيير وصيانة رخام المطابخ", "item": siteUrl + "/services/kitchen-marble/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
        {
      "@type": "Question",
      "name": "ما الفرق بين الرخام الصناعي والطبيعي للمطبخ؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "الطبيعي أكثر فخامة وأقوى ضد الحرارة، لكنه مسامي ويمتص السوائل ويحتاج عزلًا دوريًا. الصناعي مقاوم للامتصاص وسهل الترميم والتلميع، لكنه يتشوه مع الحرارة المباشرة ويحتاج استخدام قاعدة حرارية تحت الأواني الساخنة."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكن إصلاح شرخ في الرخام بدل تغييره؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "في الغالب نعم، إذا كان الشرخ سطحيًا أو في مجال الحوض ولم يتوغل في الخشب. إذا كان الشرخ قد أفسد قلب الخشب أو كان في السطح كاملًا، فقد يكون الاستبدال أكثر جدوى. نحدد ذلك بالفحص."
      }
    },
    {
      "@type": "Question",
      "name": "كم يستغرق تغيير رخام مطبخ كامل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "المطبخ المتوسط يحتاج إلى يومين إلى ثلاثة: يوم للفك والتحضير وتركيب السطح، ويوم للتلميع والتشطيب والعزل. إذا كان هناك حاجة لتعديل شبكة الخشب تحته، قد يمتد يومًا إضافيًا."
      }
    },
    {
      "@type": "Question",
      "name": "هل تعملون على رخام كوارتز؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، الكوارتز من أكثر الأسطح شيوعًا اليوم، ونعمل على قصّه وتلميعه وتغيير مجالي الحوض فيه. لكن أدوات القص تختلف عن الرخام الطبيعي، لذلك نوفر الأدوات المناسبة."
      }
    },
    {
      "@type": "Question",
      "name": "هل يتم التنظيف بعد العمل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم. غبار الرخام كثيف وينتشر، لذلك نغطي الأسطح أثناء العمل ونستخدم شفّاطًا صناعيًا، ثم نغسل السطح ونمسح المكان بالكامل قبل المغادرة."
      }
    }
  ]
};
---

<Layout
  title="تغيير وصيانة رخام المطابخ بالدمام | رخام صناعي وطبيعي 0552854516"
  description="تغيير وصيانة رخام المطابخ بالدمام: معالجة الشروخ، تلميع الرخام الصناعي والطبيعي، تبديل المجالي، وتفصيل أحواض جديدة."
  page="services"
  ogImage="/img/kitchen-project-11-1400.jpg"
  ogImageWidth={1400}
  ogImageHeight={788}
>
  <Header slot="header" />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="page-hero" style="background-image: url('/img/kitchen-project-11-1400.jpg');">
    <div class="container">
      <nav class="crumbs" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a> / <a href="/services/">خدماتنا</a> / <span>تغيير وصيانة رخام المطابخ</span>
      </nav>
      <h1>تغيير وصيانة رخام المطابخ بالدمام</h1>
      <p>الرخام هو أول ما يلفت النظر في المطبخ، وأول ما يُظهر الإهمال. شرخ صغير في المجال يتحول إلى تسرب دائم يُفسد قلب الخشب تحته.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
            <p>الرخام في المطبخ يتعرض لأقسى ظروف في المنزل: ماء ساخن من الحوض، أوانٍ ساخنة من الفرن، أحجام ثقيلة، وتنظيف متكرر بمواد كيميائية. الرخام الطبيعي مسامي ويحتاج عزلًا دوريًا، والرخام الصناعي أكثر مقاومة للامتصاص لكنه يتشوّه بالحرارة المباشرة. لكل مادة سلوكها الخاص، واستخدام طريقة الصيانة الخاطئة يُتلف أي منهما.</p>
      <p>أكثر ما نراه في الدمام هو مجال حوض مشروخ أو مفصول عن الرخام، وشرخ يمتد من حافة البوتاجاز. هذه الشروخ لا تُعالج بالسيليكون فقط. السيليكون يخفي الشرخ لأسابيع ثم يعود التسرب. العلاج الصحيح يبدأ بتحديد سبب الشرخ — حركة الشبكة، أو تمدد حراري، أو انحناء الحامل — ثم إيقاف السبب قبل ملء الشرخ.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">علامات تحتاج فيها هذه الخدمة</h2>
        <p class="section-subtitle">أعراض شائعة نراها في مطابخ الدمام — كل عرض له سبب مختلف وعلاج مختلف.</p>
      </div>
      <div class="grid-3">
                <div class="card sym-card">
          <span class="sym-icon">💧</span>
          <h3>شرخ في مجال الحوض</h3>
          <p>يبقى الماء يتسرب إلى الخشب تحته. الإصلاح يعالج الخشب المتشبع والمصرف والسطح في خطوات متتابعة.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">🔥</span>
          <h3>بقعة بيضاء أو حرق في السطح</h3>
          <p>الحرارة المباشرة. للرخام الصناعي يمكن تلميع البقعة، أما الطبيعي فيحتاج ترميمًا موضعيًا.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">📏</span>
          <h3>حافة مكسورة أو مشطوفة</h3>
          <p>نحت الحافة لاستعادة شكلها المستقيم وتلميعها بنفس مستوى السطح.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">🪣</span>
          <h3>انحناء تحت ثقل</h3>
          <p>حامل السطح غير كافٍ. إضافة دعامة أو تقوية تحته قبل تركيب السطح الجديد.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">🧼</span>
          <h3>بقع زيت أو كركم</h3>
          <p>مسامية الرخام الطبيعي امتصت البقعة. تحتاج كمادة، وقد تحتاج تلميعًا موضعيًا إذا توغلت.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">🔩</span>
          <h3>رخام مفصول عن الحائط</h3>
          <p>حركة الشريط أو التمدد الحراري. إعادة اللصق بنظام لاصق مرن لا صلب.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">كيف نعمل — أربع مراحل واضحة</h2>
        <p class="section-subtitle">لا أعمال إضافية دون موافقتك، ولا تسعير غير مكتوب.</p>
      </div>
      <div class="grid-4">
                <div class="card step-card">
          <span class="step-num">1</span>
          <h3>تحديد نوع الرخام</h3>
          <p>طبيعي (رخام، جرانيت، كوارتز) أو صناعي (كوريان، ميكروليت). كل نوع له أدوات وتقنيات مختلفة.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">2</span>
          <h3>فحص السبب</h3>
          <p>هل الشرخ نتيجة حركة الشبكة أم تمدد حراري أم حادث؟ ملء الشرخ قبل إيقاف السبب يجعل الشرخ يعود.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">3</span>
          <h3>التنفيذ</h3>
          <p>الترميم الموضعي أو القص والاستبدال، مع تلميع الحافة والملامسة.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">4</span>
          <h3>العزل النهائي</h3>
          <p>طبقة عزل ضد الماء قبل التشغيل الثاني، خاصة حول مجالي الحوض مع السيليكون المقاوم للعفن.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="grid-2 split">
        <div>
          <h2 class="section-title">ماذا يشمل العمل</h2>
          <ul class="checklist">
                        <li>معالجة شروخ مجال الحوض وانفصاله عن السطح</li>
            <li>تلميع الرخام الصناعي والطبيعي بأدوات محترفة</li>
            <li>نحت الحواف المكسورة وإعادتها إلى الاستقامة</li>
            <li>استبدال مجال الحوض بمجال جديد وملائم</li>
            <li>تفصيل أحواض جديدة وتثبيتها بمادة لاصقة مرنة</li>
            <li>تقوية حامل السطح لمنع الانحناء تحت ثقل</li>
            <li>عزل السيليكون المقاوم للعفن حول المجالي</li>
          </ul>
        </div>
        <div class="split-media">
          <picture>
            <source type="image/webp" srcset="/img/kitchen-project-11-1400.webp 1400w, /img/kitchen-project-11-900.webp 900w, /img/kitchen-project-11-600.webp 600w, /img/kitchen-project-11-400.webp 400w" sizes="(max-width: 640px) 92vw, 46vw" />
            <img src="/img/kitchen-project-11-900.jpg" srcset="/img/kitchen-project-11-1400.jpg 1400w, /img/kitchen-project-11-900.jpg 900w, /img/kitchen-project-11-600.jpg 600w, /img/kitchen-project-11-400.jpg 400w" sizes="(max-width: 640px) 92vw, 46vw" alt="تغيير وصيانة رخام المطابخ بالدمام" width="600" height="600" loading="lazy" decoding="async" class="split-img card" />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">أسئلة يتكرر طرحها</h2>
        <p class="section-subtitle">أجوبة مباشرة على ما يسأل عنه العملاء قبل الحجز.</p>
      </div>
      <div class="faq-list">
                <div class="faq-item">
          <button class="faq-q" aria-expanded="false">ما الفرق بين الرخام الصناعي والطبيعي للمطبخ؟</button>
          <div class="faq-a"><p>الطبيعي أكثر فخامة وأقوى ضد الحرارة، لكنه مسامي ويمتص السوائل ويحتاج عزلًا دوريًا. الصناعي مقاوم للامتصاص وسهل الترميم والتلميع، لكنه يتشوه مع الحرارة المباشرة ويحتاج استخدام قاعدة حرارية تحت الأواني الساخنة.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">هل يمكن إصلاح شرخ في الرخام بدل تغييره؟</button>
          <div class="faq-a"><p>في الغالب نعم، إذا كان الشرخ سطحيًا أو في مجال الحوض ولم يتوغل في الخشب. إذا كان الشرخ قد أفسد قلب الخشب أو كان في السطح كاملًا، فقد يكون الاستبدال أكثر جدوى. نحدد ذلك بالفحص.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">كم يستغرق تغيير رخام مطبخ كامل؟</button>
          <div class="faq-a"><p>المطبخ المتوسط يحتاج إلى يومين إلى ثلاثة: يوم للفك والتحضير وتركيب السطح، ويوم للتلميع والتشطيب والعزل. إذا كان هناك حاجة لتعديل شبكة الخشب تحته، قد يمتد يومًا إضافيًا.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">هل تعملون على رخام كوارتز؟</button>
          <div class="faq-a"><p>نعم، الكوارتز من أكثر الأسطح شيوعًا اليوم، ونعمل على قصّه وتلميعه وتغيير مجالي الحوض فيه. لكن أدوات القص تختلف عن الرخام الطبيعي، لذلك نوفر الأدوات المناسبة.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">هل يتم التنظيف بعد العمل؟</button>
          <div class="faq-a"><p>نعم. غبار الرخام كثيف وينتشر، لذلك نغطي الأسطح أثناء العمل ونستخدم شفّاطًا صناعيًا، ثم نغسل السطح ونمسح المكان بالكامل قبل المغادرة.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">خدمات أخرى قد تحتاجها</h2>
      </div>
      <div class="other-services">
                <a href="/services/kitchen-maintenance/">صيانة مطابخ</a>
        <a href="/services/kitchen-moving-installation/">فك وتركيب ونقل مطابخ</a>
        <a href="/services/kitchen-resizing-carpentry/">تعديل وقص وتفصيل</a>
        <a href="/services/hinges-drawer-slides/">مفصلات وسحابات الأدراج</a>
        <a href="/services/ikea-ready-kitchens/">مطابخ إيكيا والجاهزة</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-box">
        <h2>تحتاج تغيير وصيانة رخام المطابخ في الدمام؟</h2>
        <p>اتصل أو أرسل صورة للمشكلة على واتساب، وسنعطيك تقديرًا واضحًا قبل الحضور.</p>
        <div class="cta-btns">
          <a href="tel:+966552854516" class="btn btn-primary btn-lg">📞 0552854516</a>
          <a href="https://wa.me/966552854516?text=مرحباً، أحتاج تغيير وصيانة رخام المطابخ بالدمام" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">💬 واتساب</a>
        </div>
      </div>
    </div>
  </section>

  <IdentityCard />
  <FloatingCTA />
  <Footer slot="footer" />
</Layout>

<style>
.crumbs { font-size: .875rem; color: rgba(255,255,255,.75); margin-bottom: 1rem; }
.crumbs a { color: rgba(255,255,255,.9); text-decoration: underline; text-underline-offset: 3px; }
.crumbs span { color: #fff; font-weight: 700; }

.prose { max-width: 820px; margin: 0 auto; }
.prose p { color: var(--text-secondary); line-height: 1.95; font-size: 1.06rem; margin-bottom: 1.4rem; text-align: start; }

.sym-card { text-align: start; }
.sym-icon { font-size: 2rem; margin-bottom: .75rem; display: block; }
.sym-card h3 { color: var(--color-secondary); font-size: 1.1rem; margin-bottom: .6rem; }
[data-theme="dark"] .sym-card h3 { color: var(--color-accent); }
.sym-card p { color: var(--text-secondary); line-height: 1.75; font-size: .95rem; }

.step-card { position: relative; padding-top: 2.5rem; }
.step-num { position: absolute; top: 1rem; inset-inline-start: 1.2rem; width: 2rem; height: 2rem; border-radius: 50%; background: var(--color-primary); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: .9rem; }
.step-card h3 { font-size: 1.02rem; margin-bottom: .55rem; color: var(--color-secondary); }
[data-theme="dark"] .step-card h3 { color: var(--color-accent); }
.step-card p { color: var(--text-secondary); line-height: 1.7; font-size: .93rem; }

.split { align-items: center; gap: 2.5rem; }
.split-img { width: 100%; height: auto; display: block; object-fit: cover; padding: 0; }
.checklist { list-style: none; padding: 0; margin: 1.5rem 0 0; }
.checklist li { position: relative; padding-inline-start: 1.9rem; margin-bottom: .85rem; color: var(--text-secondary); line-height: 1.7; }
.checklist li::before { content: "✓"; position: absolute; inset-inline-start: 0; top: 0; width: 1.3rem; height: 1.3rem; border-radius: 50%; background: var(--color-primary); color: #fff; display: grid; place-items: center; font-size: .72rem; font-weight: 900; }

.faq-list { max-width: 860px; margin: 0 auto; }
.faq-item { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--border-radius); margin-bottom: .9rem; overflow: hidden; }
.faq-q { width: 100%; text-align: start; background: none; border: 0; padding: 1.15rem 1.3rem; font-family: inherit; font-size: 1rem; font-weight: 700; color: var(--text-primary); cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
.faq-q::after { content: "+"; font-size: 1.4rem; color: var(--color-primary); flex-shrink: 0; transition: transform .3s; }
.faq-item.open .faq-q::after { transform: rotate(45deg); }
.faq-a { max-height: 0; overflow: hidden; transition: max-height .35s ease; }
.faq-item.open .faq-a { max-height: 500px; }
.faq-a p { padding: 0 1.3rem 1.2rem; color: var(--text-secondary); line-height: 1.85; margin: 0; }

.other-services { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; }
.other-services a { background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); padding: .7rem 1.3rem; border-radius: 100px; text-decoration: none; font-weight: 600; font-size: .92rem; transition: var(--transition); }
.other-services a:hover { background: var(--color-primary); color: #fff; border-color: var(--color-primary); transform: translateY(-2px); }

.cta-box { background: var(--bg-section-alt); border-radius: var(--border-radius-xl); padding: 3rem 2rem; text-align: center; border: 1px solid var(--border-color); }
.cta-box h2 { font-size: 1.7rem; margin-bottom: .8rem; color: var(--color-secondary); }
[data-theme="dark"] .cta-box h2 { color: var(--color-accent); }
.cta-box p { color: var(--text-secondary); margin-bottom: 1.6rem; line-height: 1.7; }
.cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

@media (max-width: 768px) {
  .prose p { text-align: center; }
}
</style>

<script>
  document.querySelectorAll('.faq-q').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const open = item.classList.contains('open');
      item.parentElement.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
      if (!open) item.classList.add('open');
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
</script>
