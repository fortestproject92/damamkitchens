---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import IdentityCard from '../../components/IdentityCard.astro';

const siteUrl = 'https://www.damamkitchens.com';
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "فك وتركيب ونقل مطابخ بالدمام",
  "serviceType": "فك وتركيب ونقل مطابخ بالدمام",
  "description": "فك المطابخ ونقلها وإعادة تركيبها بالدمام بدقة: ترقيم القطع، تغليف الدرف، تعديل المقاسات للمكان الجديد، وإعادة تجميع مطابق للأصل.",
  "areaServed": [
    { "@type": "City", "name": "الدمام" },
    { "@type": "City", "name": "الخبر" },
    { "@type": "City", "name": "الظهران" },
    { "@type": "City", "name": "القطيف" },
    { "@type": "City", "name": "الجبيل" }
  ],
  "provider": {
    "@type": "HomeAndConstructionBusiness",
    "name": "فني مطابخ وصيانة مطابخ بالدمام",
    "telephone": "+966552854516",
    "url": siteUrl,
    "image": siteUrl + "/img/logo-mark-360.jpg"
  },
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "areaServed": "الدمام، المنطقة الشرقية"
  },
  "url": siteUrl + "/services/kitchen-moving-installation/"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "خدماتنا", "item": siteUrl + "/services/" },
    { "@type": "ListItem", "position": 3, "name": "فك وتركيب ونقل مطابخ بالدمام", "item": siteUrl + "/services/kitchen-moving-installation/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
        {
      "@type": "Question",
      "name": "هل يمكن نقل المطبخ كاملًا بدون تلف؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم بشرط أن تُفكّ بسلسلة مرقّمة وليس بترتيب عشوائي. المطبخ الذي يُفكّ عشوائيًا تختلط قطعه ثم يُعاد تجميعه على الحدس، فيظهر انحراف يتسع مع الوقت. الترقيم هو ما يحفظ الاستقامة."
      }
    },
    {
      "@type": "Question",
      "name": "ماذا لو اختلفت مقاسات المطبخ الجديد؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "هذا هو الوضع الغالب وليس الاستثناء. زوايا الجدران والأعمدة تختلف من شقة لأخرى، لذلك نقيس المكان الجديد قبل يوم التركيب ونحدد التعديلات اللازمة: قص وحدة، إضافة تعبئة، أو تعديل فتحة الحوض والغاز."
      }
    },
    {
      "@type": "Question",
      "name": "كم يستغرق فك وتركيب مطبخ كامل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "المطبخ المتوسط من 8 إلى 12 وحدة يستغرق عادة يومًا للفك والنقل ويومًا للتركيب. المطابخ الكبيرة أو التي تحتاج تعديلات تفصيل قد تمتد لثلاثة أيام. نعطيك التقدير الواقعي عند القياس."
      }
    },
    {
      "@type": "Question",
      "name": "هل تفكون أجهزة الغاز والسباكة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نفك التوصيلات الظاهرة ونعيد تركيبها في المكان الجديد، لكن توصيل الغاز النهائي يحتاج فنيًا معتمدًا من الجهة المختصة. ننسّق ذلك معك ونترك الأجهزة جاهزة للتوصيل."
      }
    },
    {
      "@type": "Question",
      "name": "هل تنقلون الأجهزة والمطبخ معًا؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نقل المطبخ يشمل الوحدات والأبواب والأدراج. الأجهزة الكهربائية — الثلاجة والفرن والغسالة — يمكن نقلها بالتنسيق المسبق."
      }
    }
  ]
};
---

<Layout
  title="فك وتركيب ونقل مطابخ بالدمام | فك وتركيب احترافي 0552854516"
  description="فك المطابخ ونقلها وإعادة تركيبها بالدمام بدقة: ترقيم القطع، تغليف الدرف، تعديل المقاسات للمكان الجديد، وإعادة تجميع مطابق للأصل."
  page="services"
  ogImage="/img/kitchen-fitout-dammam-1400.jpg"
  ogImageWidth={1400}
  ogImageHeight={788}
>
  <Header slot="header" />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="page-hero" style="background-image: url('/img/kitchen-fitout-dammam-1400.jpg');">
    <div class="container">
      <nav class="crumbs" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a> / <a href="/services/">خدماتنا</a> / <span>فك وتركيب ونقل مطابخ بالدمام</span>
      </nav>
      <h1>فك وتركيب ونقل مطابخ بالدمام — مطبخك ينتقل سليمًا</h1>
      <p>النقل الخاطئ هو السبب الأول لتلف المطابخ عند الانتقال. الترقيم والتغليف والترتيب ليست رفاهية — هي الفرق بين مطبخ يعمل ومطبخ يتحول إلى خشب مكسور.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
            <p>عند الانتقال، يبدو المطبخ كأنه مجموعة قطع منفصلة يمكن حملها كما هي. الحقيقة أن تركيبه يعتمد على تسلسل دقيق: كل وحدة تحمل موقعها في الشبكة، وكل ثقب تثبيت صُنع ليتقابل مع ثقب مقابل. إذا اختلطت القطع أو كُسرت حوافها، فلن تعود الشبكة لتتقابل كما كانت، وسيظهر انحراف بسيط في البداية ثم يتسع مع الوقت.</p>
      <p>فريق الفك والتركيب يعمل على مرحلتين منفصلتين بمنهج ثابت. المرحلة الأولى هي التوثيق والتفكيك المنظم: تصوير الشبكة قبل لمسها، ترقيم كل وحدة وكل باب، تغليف الحواف والأسطح. المرحلة الثانية هي إعادة التجميع في المكان الجديد، وكثيرًا ما تتطلب تعديلًا في المقاسات لأن زوايا الجدران في الشقة الجديدة لا تشبه القديمة.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">علامات تحتاج فيها هذه الخدمة</h2>
        <p class="section-subtitle">أعراض شائعة نراها في مطابخ الدمام — كل عرض له سبب مختلف وعلاج مختلف.</p>
      </div>
      <div class="grid-3">
                <div class="card sym-card">
          <span class="sym-icon">📸</span>
          <h3>توثيق قبل الفك</h3>
          <p>تصوير كل شبكة من ثلاث زوايا وترقيم الوحدات والأبواب برقم موحد. الصورة تحل أي خلاف عند إعادة التجميع.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">📦</span>
          <h3>تغليف الأطراف والزجاج</h3>
          <p>حواف MDF تتفتت بأي اصطدام. تغليف كل وحدة بطبقة واقية للأطراف، وفصل الأدراج عن الأبواب في أكياس منفصلة.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">📐</span>
          <h3>قياس المكان الجديد</h3>
          <p>قياس الشبكة والحوائط والزوايا والأعمدة قبل الحضور. أي انحراف عن المقاس القديم يحوَّل إلى تعديل تفصيل قبل التركيب.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">🔧</span>
          <h3>تعديل المقاسات</h3>
          <p>قص وحدة أو إضافة تعبئة أو تعديل موقع حوض الكهرباء. بدون هذا التعديل لن تُغلق الشبكة على الجدار.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">⚙️</span>
          <h3>إعادة تجميع مطابقة</h3>
          <p>تركيب الوحدات بترتيبها الأصلي، ضبط الأبواب، وإعادة ضبط الأدراج على سككها.</p>
        </div>
        <div class="card sym-card">
          <span class="sym-icon">✅</span>
          <h3>تشغيل وفحص نهائي</h3>
          <p>اختبار كل باب ودرج وفتح تجويفات الحوض والغاز للتأكد أن المطبخ يعمل كما كان.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">كيف نعمل — أربع مراحل واضحة</h2>
        <p class="section-subtitle">لا أعمال إضافية دون موافقتك، ولا تسعير غير مكتوب.</p>
      </div>
      <div class="grid-4">
                <div class="card step-card">
          <span class="step-num">1</span>
          <h3>زيارة قياس للمكان الجديد</h3>
          <p>نقيس جدران المطبخ الجديد ونقارنها بمقاسات المطبخ الحالي، لنعرف مسبقًا ما يحتاج تعديلًا.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">2</span>
          <h3>الفك المنظم</h3>
          <p>ترقيم وتصوير وتغليف. كل وحدة تُفك بمساميرها الأصلية ويُحفظ كل طقم مسامير في كيس مخصص.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">3</span>
          <h3>النقل الآمن</h3>
          <p>تحميل عمودي مع فواصل، لا رصّ أفقي يتسبب في انحناء الوحدات.</p>
        </div>
        <div class="card step-card">
          <span class="step-num">4</span>
          <h3>إعادة التركيب</h3>
          <p>تجميع في المكان الجديد مع تعديل المقاسات اللازمة، والانتهاء بضبط كل الأبواب والأدراج.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="grid-2 split">
        <div>
          <h2 class="section-title">ماذا يشمل العمل</h2>
          <ul class="checklist">
                        <li>تصوير وترقيم كل وحدة وباب ودرج قبل الفك</li>
            <li>تغليف حواف MDF والأسطح القابلة للخدش</li>
            <li>حفظ المسامير الأصلية بأكياس مرقمة لكل وحدة</li>
            <li>قياس المكان الجديد قبل يوم التركيب ومقارنته بالمقاس القديم</li>
            <li>قص أو إضافة تعبئة لتعديل المقاسات عند اختلاف الزوايا</li>
            <li>إعادة تجميع الشبكة بترتيبها الأصلي وضبط الفواصل</li>
            <li>ضبط نهائي لجميع المفصلات والسكك</li>
          </ul>
        </div>
        <div class="split-media">
          <picture>
            <source type="image/webp" srcset="/img/kitchen-fitout-dammam-1400.webp 1400w, /img/kitchen-fitout-dammam-900.webp 900w, /img/kitchen-fitout-dammam-600.webp 600w, /img/kitchen-fitout-dammam-400.webp 400w" sizes="(max-width: 640px) 92vw, 46vw" />
            <img src="/img/kitchen-fitout-dammam-900.jpg" srcset="/img/kitchen-fitout-dammam-1400.jpg 1400w, /img/kitchen-fitout-dammam-900.jpg 900w, /img/kitchen-fitout-dammam-600.jpg 600w, /img/kitchen-fitout-dammam-400.jpg 400w" sizes="(max-width: 640px) 92vw, 46vw" alt="فك وتركيب ونقل مطابخ بالدمام بالدمام" width="600" height="600" loading="lazy" decoding="async" class="split-img card" />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">أسئلة يتكرر طرحها</h2>
        <p class="section-subtitle">أجوبة مباشرة على ما يسأل عنه العملاء قبل الحجز.</p>
      </div>
      <div class="faq-list">
                <div class="faq-item">
          <button class="faq-q" aria-expanded="false">هل يمكن نقل المطبخ كاملًا بدون تلف؟</button>
          <div class="faq-a"><p>نعم بشرط أن تُفكّ بسلسلة مرقّمة وليس بترتيب عشوائي. المطبخ الذي يُفكّ عشوائيًا تختلط قطعه ثم يُعاد تجميعه على الحدس، فيظهر انحراف يتسع مع الوقت. الترقيم هو ما يحفظ الاستقامة.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">ماذا لو اختلفت مقاسات المطبخ الجديد؟</button>
          <div class="faq-a"><p>هذا هو الوضع الغالب وليس الاستثناء. زوايا الجدران والأعمدة تختلف من شقة لأخرى، لذلك نقيس المكان الجديد قبل يوم التركيب ونحدد التعديلات اللازمة: قص وحدة، إضافة تعبئة، أو تعديل فتحة الحوض والغاز.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">كم يستغرق فك وتركيب مطبخ كامل؟</button>
          <div class="faq-a"><p>المطبخ المتوسط من 8 إلى 12 وحدة يستغرق عادة يومًا للفك والنقل ويومًا للتركيب. المطابخ الكبيرة أو التي تحتاج تعديلات تفصيل قد تمتد لثلاثة أيام. نعطيك التقدير الواقعي عند القياس.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">هل تفكون أجهزة الغاز والسباكة؟</button>
          <div class="faq-a"><p>نفك التوصيلات الظاهرة ونعيد تركيبها في المكان الجديد، لكن توصيل الغاز النهائي يحتاج فنيًا معتمدًا من الجهة المختصة. ننسّق ذلك معك ونترك الأجهزة جاهزة للتوصيل.</p></div>
        </div>
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">هل تنقلون الأجهزة والمطبخ معًا؟</button>
          <div class="faq-a"><p>نقل المطبخ يشمل الوحدات والأبواب والأدراج. الأجهزة الكهربائية — الثلاجة والفرن والغسالة — يمكن نقلها بالتنسيق المسبق.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">خدمات أخرى قد تحتاجها</h2>
      </div>
      <div class="other-services">
                <a href="/services/kitchen-maintenance/">صيانة مطابخ</a>
        <a href="/services/kitchen-resizing-carpentry/">تعديل وقص وتفصيل</a>
        <a href="/services/hinges-drawer-slides/">مفصلات وسحابات الأدراج</a>
        <a href="/services/kitchen-marble/">رخام المطابخ</a>
        <a href="/services/ikea-ready-kitchens/">مطابخ إيكيا والجاهزة</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-box">
        <h2>تحتاج فك وتركيب ونقل مطابخ بالدمام في الدمام؟</h2>
        <p>اتصل أو أرسل صورة للمشكلة على واتساب، وسنعطيك تقديرًا واضحًا قبل الحضور.</p>
        <div class="cta-btns">
          <a href="tel:+966552854516" class="btn btn-primary btn-lg">📞 0552854516</a>
          <a href="https://wa.me/966552854516?text=مرحباً، أحتاج فك وتركيب ونقل مطابخ بالدمام بالدمام" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">💬 واتساب</a>
        </div>
      </div>
    </div>
  </section>

  <IdentityCard />
  <FloatingCTA />
  <Footer slot="footer" />
</Layout>

<style>
.crumbs { font-size: .875rem; color: rgba(255,255,255,.75); margin-bottom: 1rem; }
.crumbs a { color: rgba(255,255,255,.9); text-decoration: underline; text-underline-offset: 3px; }
.crumbs span { color: #fff; font-weight: 700; }

.prose { max-width: 820px; margin: 0 auto; }
.prose p { color: var(--text-secondary); line-height: 1.95; font-size: 1.06rem; margin-bottom: 1.4rem; text-align: start; }

.sym-card { text-align: start; }
.sym-icon { font-size: 2rem; margin-bottom: .75rem; display: block; }
.sym-card h3 { color: var(--color-secondary); font-size: 1.1rem; margin-bottom: .6rem; }
[data-theme="dark"] .sym-card h3 { color: var(--color-accent); }
.sym-card p { color: var(--text-secondary); line-height: 1.75; font-size: .95rem; }

.step-card { position: relative; padding-top: 2.5rem; }
.step-num { position: absolute; top: 1rem; inset-inline-start: 1.2rem; width: 2rem; height: 2rem; border-radius: 50%; background: var(--color-primary); color: #fff; display: grid; place-items: center; font-weight: 800; font-size: .9rem; }
.step-card h3 { font-size: 1.02rem; margin-bottom: .55rem; color: var(--color-secondary); }
[data-theme="dark"] .step-card h3 { color: var(--color-accent); }
.step-card p { color: var(--text-secondary); line-height: 1.7; font-size: .93rem; }

.split { align-items: center; gap: 2.5rem; }
.split-img { width: 100%; height: auto; display: block; object-fit: cover; padding: 0; }
.checklist { list-style: none; padding: 0; margin: 1.5rem 0 0; }
.checklist li { position: relative; padding-inline-start: 1.9rem; margin-bottom: .85rem; color: var(--text-secondary); line-height: 1.7; }
.checklist li::before { content: "✓"; position: absolute; inset-inline-start: 0; top: 0; width: 1.3rem; height: 1.3rem; border-radius: 50%; background: var(--color-primary); color: #fff; display: grid; place-items: center; font-size: .72rem; font-weight: 900; }

.faq-list { max-width: 860px; margin: 0 auto; }
.faq-item { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--border-radius); margin-bottom: .9rem; overflow: hidden; }
.faq-q { width: 100%; text-align: start; background: none; border: 0; padding: 1.15rem 1.3rem; font-family: inherit; font-size: 1rem; font-weight: 700; color: var(--text-primary); cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
.faq-q::after { content: "+"; font-size: 1.4rem; color: var(--color-primary); flex-shrink: 0; transition: transform .3s; }
.faq-item.open .faq-q::after { transform: rotate(45deg); }
.faq-a { max-height: 0; overflow: hidden; transition: max-height .35s ease; }
.faq-item.open .faq-a { max-height: 500px; }
.faq-a p { padding: 0 1.3rem 1.2rem; color: var(--text-secondary); line-height: 1.85; margin: 0; }

.other-services { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; }
.other-services a { background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); padding: .7rem 1.3rem; border-radius: 100px; text-decoration: none; font-weight: 600; font-size: .92rem; transition: var(--transition); }
.other-services a:hover { background: var(--color-primary); color: #fff; border-color: var(--color-primary); transform: translateY(-2px); }

.cta-box { background: var(--bg-section-alt); border-radius: var(--border-radius-xl); padding: 3rem 2rem; text-align: center; border: 1px solid var(--border-color); }
.cta-box h2 { font-size: 1.7rem; margin-bottom: .8rem; color: var(--color-secondary); }
[data-theme="dark"] .cta-box h2 { color: var(--color-accent); }
.cta-box p { color: var(--text-secondary); margin-bottom: 1.6rem; line-height: 1.7; }
.cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

@media (max-width: 768px) {
  .prose p { text-align: center; }
}
</style>

<script>
  document.querySelectorAll('.faq-q').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const open = item.classList.contains('open');
      item.parentElement.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
      if (!open) item.classList.add('open');
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
</script>
