---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';

const siteUrl = 'https://www.damamkitchens.com';
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "دليل اختيار فني مطابخ في الدمام — خمسة معايير قبل الطلب",
  "description": "خمسة معايير عملية للتحقق من فني مطابخ في الدمام قبل الطلب: التشخيص قبل السعر، معرفة المواد، قطع غيار مصنّفة، التعديلات المعلنة، والالتزام بالوقت.",
  "image": [siteUrl + "/img/kitchen-project-15-1400.jpg"],
  "datePublished": "2026-11-20",
  "dateModified": "2026-11-20",
  "author": {
    "@type": "Organization",
    "name": "فني مطابخ وصيانة مطابخ بالدمام",
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "فني مطابخ وصيانة مطابخ بالدمام",
    "logo": { "@type": "ImageObject", "url": siteUrl + "/img/logo-mark-360.jpg" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": siteUrl + "/blog/kitchen-hinge-failure-signs/" },
  "articleSection": "دليل فني المطابخ",
  "inLanguage": "ar",
  "wordCount": 430
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "المدونة", "item": siteUrl + "/blog/" },
    { "@type": "ListItem", "position": 3, "name": "5 علامات تدل على تلف مفصلات المطبخ — وكيف تتصرف مع كل واحدة", "item": siteUrl + "/blog/kitchen-hinge-failure-signs/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [    {
      "@type": "Question",
      "name": "هل تغيير المفصلة يحتاج فك الباب؟",
      "acceptedAnswer": { "@type": "Answer", "text": "لا، في الغالب تُستبدل المفصلة والباب معلّق أو مرفوع قليلًا. الفك الكامل لا يحدث إلا إذا احتاج الأمر معالجة واسعة في الخشب." }
    },
    {
      "@type": "Question",
      "name": "كم مفصلة يحتاج كل باب؟",
      "acceptedAnswer": { "@type": "Answer", "text": "الأبواب القياسية مفصلتان، والأبواب التي يزيد ارتفاعها على 90 سم أو التي تحمل زجاجًا تحتاج ثلاثًا على الأقل." }
    },
    {
      "@type": "Question",
      "name": "هل يمكن تغيير مفصلة واحدة فقط؟",
      "acceptedAnswer": { "@type": "Answer", "text": "نعم، ونوصي به عندما تكون المفصلة الأخرى سليمة. لكن في المطابخ الأقدم من 10 سنوات، تغيير المجموعة كلها أوفر لأن الباقي على وشك التلف." }
    }]
};
---

<Layout
  title="دليل اختيار فني مطابخ بالدمام: 5 معايير قبل الطلب | صيانة مطابخ الدمام"
  description="اختيار الفني أهم من اختيار القطعة. أغلب الأعطال المتكررة سببها تشخيص خاطئ في الزيارة الأولى، لا قطعة سيئة."
  page="blog"
  ogImage="/img/kitchen-project-15-1400.jpg"
  ogImageWidth={1400}
  ogImageHeight={1400}
>
  <Header slot="header" />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="page-hero" style="background-image: url('/img/kitchen-project-15-1400.jpg');">
    <div class="container">
      <nav class="crumbs" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a> / <a href="/blog/">المدونة</a> / <span>دليل فني المطابخ</span>
      </nav>
      <h1>دليل اختيار فني مطابخ في الدمام — خمسة معايير قبل الطلب</h1>
      <p>اختيار الفني أهم من اختيار القطعة. أغلب الأعطال المتكررة سببها تشخيص خاطئ في الزيارة الأولى، لا قطعة سيئة.</p>
    </div>
  </section>

  <section class="section">
    <div class="container article-wrap">
      <div class="art-meta-bar">
        <span class="badge">دليل فني المطابخ</span>
        <span>📅 2026-11-15RA</span>
        <span>⏱️ قراءة 5 دقائق</span>
      </div>

      <div class="art-body">
                <p>المفصلة هي أكثر قطعة تُستهلك في المطبخ. الباب الواحد يُفتح ويُغلق في المتوسط 30 إلى 50 مرة يوميًا، أي ما يزيد على 15,000 مرة في السنة. عندما تبدأ في التلف، لا يحدث السقوط في اليوم الأول — بل تمر المشكلة بمراحل يمكن عند كل منها توقيف التلف بتكلفة أقل.</p>
        <h2>العلامة الأولى: الباب لا يبقى مغلقًا</h2>
        <p>إذا كنت تحتاج إلى دفع الباب بقوة حتى يثبت في مكانه، أو يفتح من نفسه ببساطة، فالنابض الداخلي للمفصلة فقد ضغطه. عند هذه المرحلة، الشد الميكانيكي لن يعيد الوظيفة. المفصلة المرتخية التي تُشد باستمرار تستهلك بسرعة أكبر بعد كل شد، لأن محورها يتآكل من الحركة غير المنتظمة.</p>
        <p>العلاج: استبدال المفصلة. ليس كل المفصلات — فقط المتأثرة. وهذا ما نفعله في زيارة واحدة.</p>
        <h2>العلامة الثانية: صوت تصفيق عند الإغلاق</h2>
        <p>المفصلة الهيدروليكية السليمة تُغلق ببطء في آخر 15 درجة من الحركة، بفعل صمام داخلي يتحكم في سرعة تدفق الزيت. الصوت الحاد عند الإغلاق يعني أن هذا الصمام تلف أو أن الزيت تسرّب.</p>
        <p>هذه العلامة تحديدًا تستحق الانتباه، لأن التصفيق المتكرر يرسل صدمة إلى الخشب حول المفصلة. بعد أشهر من التصفيق، تصبح المسامير مرتخية ثم تتفتت الثقوب، وهنا يبدأ التلف الأكبر.</p>
        <h2>العلامة الثالثة: فراغ غير متساوٍ بين الأبواب</h2>
        <p>هذه العلامة ليست بالضرورة عيبًا في المفصلة. في كثير من الحالات، يكون الفراغ المائل بسبب خلل في ضبط البراغي الثلاثة الموجودة على كل مفصلة. البرغي الأول يحرك الباب أفقيًا، والثاني عموديًا، والثالث يتحكم في العمق.</p>
        <p>قبل تغيير المفصلة، نجرب الضبط. نحو 30 بالمئة من الحالات التي تصل إلينا بهذه الشكوى تُحل بالضبط وحده دون تغيير أي قطعة.</p>
        <h2>العلامة الرابعة: خشب متفتت حول المفصلة</h2>
        <p>هذه أخطر علامة، ولا تُحل بتغيير المفصلة. المسامير لم تعد تُمسك لأن ألياف الخشب حول الثقب مكسورة. تركيب مفصلة جديدة في الثقب القديم يعطيني ثباتًا لأسبوعين ثم تعود المشكلة.</p>
        <p>الحل الصحيح: حشوة خشبية (wood dowel) مع غراء خشب تُعيد بناء الألياف، ثم تثبيت المفصلة بمسامير في موقع جديد سليم. إذا كان الجزء المتضرر واسعًا، نضيف لوح تدعيم داخلي.</p>
        <h2>العلامة الخامسة: حافة الباب تحتك بالرخام أو الدرج</h2>
        <p>عندما ينخفض الباب قليلًا، تبدأ حافته السفلية بالاحتكاك بمستوى الرخام أو بواجهة الدرج. الاحتكاك يزيل الطلاء، ويجعل الباب يُفتح بصعوبة أكبر، فيستهلك المفصلة أسرع.</p>
        <p>هذه العلامة تعني أن المفصلة تلفت بالفعل وأن الباب فقد جزءًا من استقامته. الإصلاح هنا يستغرق دقائق ويمنع تلفًا أكبر في الحافة والرخام.</p>
        <h2>متى يكون الإصلاح غير مُجدٍ؟</h2>
        <p>إذا كان قلب الخشب متفتتًا في أكثر من موقع ربط، أو إذا كانت الشبكة نفسها منحنية، فالإصلاح الجزئي سيستمر في العودة. في هذه الحالات نكون صريحين: الاستبدال الكامل أرخص على المدى الطويل من إصلاحات متكررة.</p>
        <p>لكن إذا كان الخشب سليمًا والمشكلة في القطعة فقط، فاستبدال المفصلات على مرحلتين (الأكثر استخدامًا أولًا) يعطي عمرًا إضافيًا 3 إلى 5 سنوات بتكلفة صغيرة.</p>
      </div>

      <div class="takeaways-box">
        <h2>أبرز ما في المقال</h2>
        <ul>
                    <li>كل علامة من العلامات الخمس لها علاج مختلف — التشخيص الخاطئ يعني مالًا يُهدر.</li>
          <li>الضبط المجاني يحل نحو ثلث الحالات، فجرّبه قبل تغيير القطعة.</li>
          <li>خشب متفتت يعني حشوة خشبية لا مفصلة جديدة في الثقب القديم.</li>
          <li>المعيار الوحيد لتحديد نوع المفصلة هو وزن الباب لا سعرها.</li>
        </ul>
      </div>

      <div class="art-cta">
        <h2>مطبخك يعاني من نفس المشكلة؟</h2>
        <p>أرسل صورة على واتساب، وسنخبرك بالسبب المحتمل والتكلفة قبل الحضور. الفحص الهاتفي مجاني.</p>
        <div class="cta-btns">
          <a href="tel:+966552854516" class="btn btn-primary btn-lg">📞 0552854516</a>
          <a href="https://wa.me/966552854516?text=مرحباً، قرأت مقال 5 علامات تدل على تلف مفصلات المطبخ — وكيف تتصرف مع كل واحدة وأود استشارة" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener noreferrer">💬 واتساب</a>
        </div>
      </div>

      <div class="faq-list">
        <h2>أسئلة مرتبطة</h2>
        <div class="faq-item"><button class="faq-q" aria-expanded="false">كيف أعرف أن الفني شخّص المشكلة صحيحًا؟</button><div class="faq-a"><p>اطلب منه أن يذكر السبب وبديلين على الأقل للخطة. الفني الذي يفكّر مسبقًا يذكر ما سيفعله إذا اختلف الواقع.</p></div></div>
        <div class="faq-item"><button class="faq-q" aria-expanded="false">هل السعر الأرخص مؤشر على جودة أقل؟</button><div class="faq-a"><p>ليس دائمًا، لكن السعر الأقل بكثير من المتوسط يعني غالبًا قطعة غيار غير مصنفة أو عملًا سريعًا. الفارق يظهر بعد ستة أشهر في تكرار العطل.</p></div></div>
        <div class="faq-item"><button class="faq-q" aria-expanded="false">هل يجب أن أطلب ضمانًا مكتوبًا؟</button><div class="faq-a"><p>نعم، على الأقل على القطع المستبدلة. الضمان الشفهي يفقد قيمته عند الخلاف. اطلب تحديد المدة وما يغطيه بوضوح.</p></div></div>
      </div>

      <div class="related">
        <h2>اقرأ أيضًا</h2>
        <div class="related-grid">
                    <a href="/blog/soft-close-hinges-investment/">مفصلات الهيدروليك الناعمة: لماذا تعتبر الاستثمار الأفضل لمطبخك؟</a>
          <a href="/blog/sink-cabinet-moisture-dammam/">حماية خزانة حوض الجلي من الرطوبة والعفن بالدمام</a>
          <a href="/blog/kitchen-moving-checklist/">قائمة فحص قبل نقل مطبخك — ما يجب أن تفعله قبل يوم الانتقال</a>
        </div>
      </div>
    </div>
  </section>

  <FloatingCTA />
  <Footer slot="footer" />
</Layout>

<style>
.crumbs { font-size: .875rem; color: rgba(255,255,255,.75); margin-bottom: 1rem; }
.crumbs a { color: rgba(255,255,255,.9); text-decoration: underline; text-underline-offset: 3px; }
.crumbs span { color: #fff; font-weight: 700; }

.article-wrap { max-width: 800px; margin: 0 auto; }

.art-meta-bar { display: flex; gap: 1.2rem; flex-wrap: wrap; align-items: center; margin-bottom: 2rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--border-color); font-size: .9rem; color: var(--text-muted); }

.art-body h2 { font-size: 1.45rem; margin: 2.4rem 0 .9rem; color: var(--color-secondary); }
[data-theme="dark"] .art-body h2 { color: var(--color-accent); }
.art-body p { color: var(--text-secondary); line-height: 1.95; font-size: 1.06rem; margin-bottom: 1.3rem; text-align: start; }
.art-body ul { margin: 0 0 1.5rem; padding-inline-start: 1.5rem; }
.art-body li { color: var(--text-secondary); line-height: 1.85; margin-bottom: .65rem; }

.takeaways-box { background: var(--bg-section-alt); border: 1px solid var(--border-color); border-radius: var(--border-radius-lg); padding: 1.8rem 2rem; margin: 2.5rem 0; }
.takeaways-box h2 { font-size: 1.2rem; margin-bottom: 1rem; color: var(--color-secondary); }
[data-theme="dark"] .takeaways-box h2 { color: var(--color-accent); }
.takeaways-box ul { list-style: none; padding: 0; margin: 0; }
.takeaways-box li { position: relative; padding-inline-start: 1.9rem; margin-bottom: .8rem; color: var(--text-secondary); line-height: 1.7; }
.takeaways-box li::before { content: "✓"; position: absolute; inset-inline-start: 0; top: 0; width: 1.3rem; height: 1.3rem; border-radius: 50%; background: var(--color-primary); color: #fff; display: grid; place-items: center; font-size: .72rem; font-weight: 900; }

.art-cta { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--border-radius-xl); padding: 2.2rem; margin: 2.5rem 0; text-align: center; }
.art-cta h2 { font-size: 1.35rem; margin-bottom: .7rem; color: var(--color-secondary); }
[data-theme="dark"] .art-cta h2 { color: var(--color-accent); }
.art-cta p { color: var(--text-secondary); margin-bottom: 1.4rem; line-height: 1.7; }
.cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

.faq-list h2 { font-size: 1.4rem; margin-bottom: 1.2rem; color: var(--color-secondary); }
[data-theme="dark"] .faq-list h2 { color: var(--color-accent); }
.faq-item { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--border-radius); margin-bottom: .8rem; overflow: hidden; }
.faq-q { width: 100%; text-align: start; background: none; border: 0; padding: 1.1rem 1.25rem; font-family: inherit; font-size: 1rem; font-weight: 700; color: var(--text-primary); cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
.faq-q::after { content: "+"; font-size: 1.4rem; color: var(--color-primary); flex-shrink: 0; transition: transform .3s; }
.faq-item.open .faq-q::after { transform: rotate(45deg); }
.faq-a { max-height: 0; overflow: hidden; transition: max-height .35s ease; }
.faq-item.open .faq-a { max-height: 500px; }
.faq-a p { padding: 0 1.25rem 1.15rem; color: var(--text-secondary); line-height: 1.85; margin: 0; }

.related { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-color); }
.related h2 { font-size: 1.3rem; margin-bottom: 1.2rem; color: var(--color-secondary); }
[data-theme="dark"] .related h2 { color: var(--color-accent); }
.related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; }
.related-grid a { display: block; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--border-radius); padding: 1.1rem 1.25rem; text-decoration: none; color: var(--text-primary); font-weight: 600; font-size: .95rem; line-height: 1.6; transition: var(--transition); }
.related-grid a:hover { border-color: var(--color-primary); transform: translateY(-2px); }

@media (max-width: 768px) {
  .art-body p { text-align: center; }
  .art-body ul { padding-inline-start: 0; list-style-position: inside; text-align: center; }
}
</style>

<script>
  document.querySelectorAll('.faq-q').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const open = item.classList.contains('open');
      item.parentElement.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
      if (!open) item.classList.add('open');
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
</script>
