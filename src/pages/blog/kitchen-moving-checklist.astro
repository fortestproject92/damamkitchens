const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [    {
      "@type": "Question",
      "name": "هل يستحق نقل المطبخ أم تفصيل جديد أفضل؟",
      "acceptedAnswer": { "@type": "Answer", "text": "إذا كان المطبخ أقل من عشر سنوات وفي حالة جيدة، فنقله يستحق. أما إذا كان قد بدأ في التفتت، فتكاليف النقل والتعديل قد تقترب من تكلفة التفصيل في المكان الجديد." }
