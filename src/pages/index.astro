---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import IdentityCard from '../components/IdentityCard.astro';
---

<Layout
  title="صيانه مطابخ وإصلاح مفصلات في الدمام | فني متخصص ومحترف"
  description="أفضل خدمات صيانة مطابخ وإصلاح وتغيير مفصلات المطابخ في الدمام والخبر والمنطقة الشرقية. سرعة في التجاوب، دقة متناهية، متواجدون يومياً من 7 صباحاً حتى 2 بعد منتصف الليل."
  page="home"
>
  <Header slot="header" />

  <!-- HERO SECTION WITH FLOATING REAL KITCHEN IMAGE (0552854516.jpg) -->
  <section class="hero-section">
    <!-- Floating Background Image -->
    <div class="hero-bg-image"></div>
    <div class="hero-bg-overlay">
      <div class="ambient-orb orb-1"></div>
      <div class="ambient-orb orb-2"></div>
      <div class="ambient-orb orb-3"></div>
      <div class="hero-grid-pattern"></div>

      <!-- Small Floating Kitchen Repair Icons -->
      <div class="floating-tool tool-hinge" title="مفصلة مطبخ هيدروليك">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="16" rx="2"></rect>
          <line x1="12" y1="4" x2="12" y2="20"></line>
          <circle cx="7.5" cy="8.5" r="1.5" fill="currentColor"></circle>
          <circle cx="7.5" cy="15.5" r="1.5" fill="currentColor"></circle>
          <circle cx="16.5" cy="8.5" r="1.5" fill="currentColor"></circle>
          <circle cx="16.5" cy="15.5" r="1.5" fill="currentColor"></circle>
        </svg>
      </div>

      <div class="floating-tool tool-wrench" title="مفتاح ضبط وصيانة">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
        </svg>
      </div>

      <div class="floating-tool tool-screw" title="براغي تثبيت صلبة">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M7 2h10l-2 5H9L7 2z"></path>
          <line x1="12" y1="7" x2="12" y2="22"></line>
          <line x1="9" y1="11" x2="15" y2="13"></line>
          <line x1="9" y1="15" x2="15" y2="17"></line>
          <line x1="10" y1="19" x2="14" y2="20"></line>
        </svg>
      </div>

      <div class="floating-tool tool-drawer" title="سحاب ومجرى أدراج">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <rect x="2" y="4" width="20" height="7" rx="1"></rect>
          <rect x="2" y="13" width="20" height="7" rx="1"></rect>
          <line x1="10" y1="7.5" x2="14" y2="7.5"></line>
          <line x1="10" y1="16.5" x2="14" y2="16.5"></line>
        </svg>
      </div>

      <div class="floating-tool tool-ruler" title="وزن وضبط الفواصل">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M21.3 8.7 8.7 21.3c-.4.4-1 .4-1.4 0L2.7 16.7c-.4-.4-.4-1 0-1.4L15.3 2.7c.4-.4 1-.4 1.4 0l4.6 4.6c.4.4.4 1 0 1.4z"></path>
          <line x1="7" y1="14" x2="9" y2="16"></line>
          <line x1="10" y1="11" x2="12" y2="13"></line>
          <line x1="13" y1="8" x2="15" y2="10"></line>
        </svg>
      </div>

      <div class="floating-tool tool-driver" title="مفك صيانة دقيق">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="m15 4 5 5"></path>
          <path d="m18 7-8.5 8.5a2.12 2.12 0 0 1-1.5.6H5v-3a2.12 2.12 0 0 1 .6-1.5L14 3z"></path>
          <path d="M3 21l3-3"></path>
        </svg>
      </div>

      <div class="floating-tool tool-sparkle" title="تجديد ونظافة تامة">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 2z"></path>
        </svg>
      </div>

      <div class="floating-tool tool-door" title="كبائن وأبواب مطابخ">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <rect x="4" y="2" width="16" height="20" rx="2"></rect>
          <circle cx="8" cy="12" r="1.5" fill="currentColor"></circle>
        </svg>
      </div>
    </div>
    <div class="container hero-container">
      
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        <span data-ar="متاحون الآن لخدمتكم في الدمام والشرقية" data-en="Available Now in Dammam & Eastern Province">متاحون الآن لخدمتكم في الدمام والشرقية</span>
      </div>

      <h1 class="hero-title">
        <span data-ar="صيانة مطابخ وإصلاح مفصلات في الدمام" data-en="Kitchen Maintenance & Hinge Repair in Dammam">صيانة مطابخ وإصلاح مفصلات في الدمام</span>
      </h1>

      <p class="hero-desc" data-ar="نقدم لك الحل الجذري والاحترافي لجميع مشاكل مطبخك: إصلاح المفصلات الهابطة، تبديل المفصلات التالفة بالهيدروليك الإيطالي والألماني، تصليح السحابات، وصيانة الخزائن بدقة وجودة لا تضاهى." data-en="We provide the ultimate professional solution for your kitchen: fixing loose hinges, upgrading to soft-close hydraulic hinges, repairing drawer runners, and cabinet adjustments with unmatched precision.">
        نقدم لك الحل الجذري والاحترافي لجميع مشاكل مطبخك: إصلاح المفصلات الهابطة، تبديل المفصلات التالفة بالهيدروليك الإيطالي والألماني، تصليح السحابات، وصيانة الخزائن بدقة وجودة لا تضاهى.
      </p>

      <div class="hero-actions">
        <a href="https://wa.me/966552854516?text=مرحباً، أود حجز معاينة لصيانة المطبخ" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg" aria-label="واتساب">
          <span>💬</span>
          <span data-ar="طلب معاينة عبر واتساب" data-en="Request Inspection via WhatsApp">طلب معاينة عبر واتساب</span>
        </a>
        <a href="tel:+966552854516" class="btn btn-secondary btn-lg" aria-label="اتصال">
          <span>📞</span>
          <span data-ar="اتصل الآن: 0552854516" data-en="Call Now: 0552854516">اتصل الآن: 0552854516</span>
        </a>
      </div>

      <!-- THE REQUESTED FLOATING BIG WIDE HERO BANNER (UNCROPPED) -->
      <div class="floating-hero-showcase">
        <div class="floating-hero-frame">
          <img
            src="/assets/هل تبحث عن مطابخ مميزة وعصرية؟0552854516.jpg"
            alt="هل تبحث عن مطابخ مميزة وعصرية؟ صيانة مطابخ الدمام 0552854516"
            class="floating-hero-img"
            width="1200"
            height="675"
            fetchpriority="high"
            loading="eager"
          />
        </div>
      </div>

      <!-- Trust Badges -->
      <div class="hero-features">
        <div class="feat-item">
          <span class="feat-icon">⚡</span>
          <span data-ar="وصول سريع لموقعك" data-en="Fast On-Site Arrival">وصول سريع لموقعك</span>
        </div>
        <div class="feat-item">
          <span class="feat-icon">🔧</span>
          <span data-ar="قطع غيار ومفصلات أصلية" data-en="Original Spare Hinges">قطع غيار ومفصلات أصلية</span>
        </div>
        <div class="feat-item">
          <span class="feat-icon">🕐</span>
          <span data-ar="عمل يومي 7 ص - 2 بعد منتصف الليل" data-en="Daily 7 AM - 2 AM">عمل يومي 7 ص - 2 بعد منتصف الليل</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST STATS SECTION -->
  <section class="section section-stats">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card card">
          <span class="stat-num">+1500</span>
          <span class="stat-label" data-ar="مطبخ تم صيانته بنجاح" data-en="Kitchens Successfully Repaired">مطبخ تم صيانته بنجاح</span>
        </div>
        <div class="stat-card card">
          <span class="stat-num">+10</span>
          <span class="stat-label" data-ar="سنوات من الخبرة العملية" data-en="Years of Hands-on Experience">سنوات من الخبرة العملية</span>
        </div>
        <div class="stat-card card">
          <span class="stat-num">30</span>
          <span class="stat-label" data-ar="دقيقة متوسط سرعة الوصول" data-en="Minutes Average Response">دقيقة متوسط سرعة الوصول</span>
        </div>
        <div class="stat-card card">
          <span class="stat-num">100%</span>
          <span class="stat-label" data-ar="ضمان دقة العمل والرضا" data-en="Satisfaction Guaranteed">ضمان دقة العمل والرضا</span>
        </div>
      </div>
    </div>
  </section>

  <!-- BRANDED DIGITAL CARD SECTION -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title" data-ar="بطاقة التواصل والاعتماد الرسمية" data-en="Official Business & Contact Card">بطاقة التواصل والاعتماد الرسمية</h2>
        <p class="section-subtitle" data-ar="احفظ بيانات الفني المعتمد على هاتفك وتواصل معنا بضغطة زر واحدة" data-en="Save our certified technician details on your mobile and contact us instantly">احفظ بيانات الفني المعتمد على هاتفك وتواصل معنا بضغطة زر واحدة</p>
      </div>
      <IdentityCard />
    </div>
  </section>

  <!-- SERVICES OVERVIEW SECTION -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title" data-ar="خدمات صيانة المطابخ الاحترافية" data-en="Professional Kitchen Services">خدمات صيانة المطابخ الاحترافية</h2>
        <p class="section-subtitle" data-ar="نقدم حلولاً متكاملة تشمل كافة أنواع المطابخ: خشب، ألمنيوم، وإيكيا" data-en="Comprehensive solutions for all kitchen types: Wood, Aluminum, and IKEA">نقدم حلولاً متكاملة تشمل كافة أنواع المطابخ: خشب، ألمنيوم، وإيكيا</p>
      </div>

      <div class="grid-3">
        <!-- Service 1 -->
        <div class="card service-card">
          <div class="srv-img-box">
            <img src="/assets/1.jpg" alt="صيانة وإصلاح المفصلات بالدمام" class="srv-thumb" width="400" height="300" loading="lazy" />
          </div>
          <div class="srv-card-body">
            <h3 data-ar="صيانة وإصلاح المفصلات" data-en="Hinge Repair & Alignment">صيانة وإصلاح المفصلات</h3>
            <p data-ar="إعادة ضبط ووزن المفصلات المرتخية والهابطة، وتثبيتها ببراغي مدعمة لمنع سقوط أبواب الدواليب مستقبلاً." data-en="Re-aligning and tightening loose and sagging hinges with heavy-duty anchors to prevent future issues.">إعادة ضبط ووزن المفصلات المرتخية والهابطة، وتثبيتها ببراغي مدعمة لمنع سقوط أبواب الدواليب مستقبلاً.</p>
            <a href="https://wa.me/966552854516?text=أرغب في خدمة صيانة المفصلات" class="btn btn-outline" target="_blank" rel="noopener noreferrer">
              <span data-ar="طلب صيانة فورية" data-en="Request Repair">طلب صيانة فورية</span>
            </a>
          </div>
        </div>

        <!-- Service 2 -->
        <div class="card service-card">
          <div class="srv-img-box">
            <img src="/assets/2.jpg" alt="تركيب مفصلات هيدروليك ناعمة بالدمام" class="srv-thumb" width="400" height="300" loading="lazy" />
          </div>
          <div class="srv-card-body">
            <h3 data-ar="تركيب مفصلات هيدروليك ناعمة" data-en="Soft-Close Hydraulic Hinges">تركيب مفصلات هيدروليك ناعمة</h3>
            <p data-ar="ترقية مفصلات مطبخك القديمة إلى مفصلات هيدروليكية ذكية تغلق بهدوء وسلاسة دون إحداث أي ضجيج." data-en="Upgrading standard hinges to smart soft-close hydraulic hinges for silent and smooth closing.">ترقية مفصلات مطبخك القديمة إلى مفصلات هيدروليكية ذكية تغلق بهدوء وسلاسة دون إحداث أي ضجيج.</p>
            <a href="https://wa.me/966552854516?text=أرغب في تركيب مفصلات هيدروليك" class="btn btn-outline" target="_blank" rel="noopener noreferrer">
              <span data-ar="طلب صيانة فورية" data-en="Request Repair">طلب صيانة فورية</span>
            </a>
          </div>
        </div>

        <!-- Service 3 -->
        <div class="card service-card">
          <div class="srv-img-box">
            <img src="/assets/3.jpg" alt="إصلاح واستبدال سحابات الأدراج" class="srv-thumb" width="400" height="300" loading="lazy" />
          </div>
          <div class="srv-card-body">
            <h3 data-ar="إصلاح واستبدال سحابات الأدراج" data-en="Drawer Slides Repair">إصلاح واستبدال سحابات الأدراج</h3>
            <p data-ar="حل مشكلة الأدراج العالقة أو المائلة وتغيير السكك التالفة بسكك رولمان بلي عالية التحمل والجودة." data-en="Fixing jammed drawers and replacing worn rails with high-durability ball-bearing drawer slides.">حل مشكلة الأدراج العالقة أو المائلة وتغيير السكك التالفة بسكك رولمان بلي عالية التحمل والجودة.</p>
            <a href="https://wa.me/966552854516?text=أرغب في إصلاح سحابات الأدراج" class="btn btn-outline" target="_blank" rel="noopener noreferrer">
              <span data-ar="طلب صيانة فورية" data-en="Request Repair">طلب صيانة فورية</span>
            </a>
          </div>
        </div>

        <!-- Service 4 -->
        <div class="card service-card">
          <div class="srv-img-box">
            <img src="/assets/4.jpg" alt="تعديل وضبط أبواب الخزائن" class="srv-thumb" width="400" height="300" loading="lazy" />
          </div>
          <div class="srv-card-body">
            <h3 data-ar="تعديل وضبط أبواب الخزائن" data-en="Cabinet Door Re-Alignment">تعديل وضبط أبواب الخزائن</h3>
            <p data-ar="تعديل ميلان الفواصل بين الأبواب وجعلها متناسقة تماماً بمظهر متجدد كأن المطبخ جديد تماماً." data-en="Straightening misaligned cabinet doors and matching gaps evenly for a brand-new refreshed look.">تعديل ميلان الفواصل بين الأبواب وجعلها متناسقة تماماً بمظهر متجدد كأن المطبخ جديد تماماً.</p>
            <a href="https://wa.me/966552854516?text=أرغب في تعديل أبواب الخزائن" class="btn btn-outline" target="_blank" rel="noopener noreferrer">
              <span data-ar="طلب صيانة فورية" data-en="Request Repair">طلب صيانة فورية</span>
            </a>
          </div>
        </div>

        <!-- Service 5 -->
        <div class="card service-card">
          <div class="srv-img-box">
            <img src="/assets/5.jpg" alt="تدعيم وتثبيت الرفوف الداخلية" class="srv-thumb" width="400" height="300" loading="lazy" />
          </div>
          <div class="srv-card-body">
            <h3 data-ar="تدعيم وتثبيت الرفوف الداخلية" data-en="Shelf Reinforcement">تدعيم وتثبيت الرفوف الداخلية</h3>
            <p data-ar="إصلاح الرفوف المنحنية أو المكسورة وتثبيت زوايا حديدية متينة تتحمل أوزان أواني الطبخ الثقيلة." data-en="Fixing sagging shelves and installing reinforced metal brackets to bear heavy cookware weights.">إصلاح الرفوف المنحنية أو المكسورة وتثبيت زوايا حديدية متينة تتحمل أوزان أواني الطبخ الثقيلة.</p>
            <a href="https://wa.me/966552854516?text=أرغب في تدعيم الرفوف" class="btn btn-outline" target="_blank" rel="noopener noreferrer">
              <span data-ar="طلب صيانة فورية" data-en="Request Repair">طلب صيانة فورية</span>
            </a>
          </div>
        </div>

        <!-- Service 6 -->
        <div class="card service-card">
          <div class="srv-img-box">
            <img src="/assets/6.jpg" alt="صيانة شاملة وتجديد المقابض بالدمام" class="srv-thumb" width="400" height="300" loading="lazy" />
          </div>
          <div class="srv-card-body">
            <h3 data-ar="صيانة شاملة وتجديد المقابض" data-en="Comprehensive Overhaul">صيانة شاملة وتجديد المقابض</h3>
            <p data-ar="صيانة عامة لكافة أجزاء المطبخ، تغيير المقابض التالفة، ومعالجة الرطوبة أسفل حوض الجلي." data-en="Full kitchen hardware checkup, replacing old handles, and water-resistance fixes under sinks.">صيانة عامة لكافة أجزاء المطبخ، تغيير المقابض التالفة، ومعالجة الرطوبة أسفل حوض الجلي.</p>
            <a href="https://wa.me/966552854516?text=أرغب في صيانة شاملة للمطبخ" class="btn btn-outline" target="_blank" rel="noopener noreferrer">
              <span data-ar="طلب صيانة فورية" data-en="Request Repair">طلب صيانة فورية</span>
            </a>
          </div>
        </div>
      </div>

      <div class="services-footer-cta">
        <a href="/services/" class="btn btn-primary btn-lg">
          <span data-ar="استعراض كافة التفاصيل والخدمات" data-en="View All Services in Detail">استعراض كافة التفاصيل والخدمات</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PRESENTATION SHOWCASE BANNER -->
  <section class="section section-alt">
    <div class="container">
      <div class="presentation-banner-wrap">
        <img
          src="/assets/Beige Brown and White Minimalist Smart Kitchens Pitch Deck Presentation.jpg"
          alt="تصاميم وصيانة المطابخ الذكية في الدمام"
          class="presentation-banner-img"
          width="1200"
          height="675"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US SECTION -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title" data-ar="لماذا تختار فني صيانة مطابخ الدمام؟" data-en="Why Choose Our Dammam Kitchen Technician?">لماذا تختار فني صيانة مطابخ الدمام؟</h2>
        <p class="section-subtitle" data-ar="نجمع بين الخبرة العميقة وسرعة التنفيذ لتقديم أفضل تجربة صيانة ممكنة" data-en="Combining deep craftsmanship and rapid response for the ultimate maintenance experience">نجمع بين الخبرة العميقة وسرعة التنفيذ لتقديم أفضل تجربة صيانة ممكنة</p>
      </div>

      <div class="grid-4">
        <div class="card why-card">
          <div class="why-icon">🚀</div>
          <h4 data-ar="سرعة في الحضور" data-en="Rapid On-Site Arrival">سرعة في الحضور</h4>
          <p data-ar="نصل إلى موقعك في الدمام ومحيطها بأسرع وقت ممكن بعد تأكيد الطلب." data-en="We arrive at your location in Dammam and neighboring cities promptly after booking.">نصل إلى موقعك في الدمام ومحيطها بأسرع وقت ممكن بعد تأكيد الطلب.</p>
        </div>

        <div class="card why-card">
