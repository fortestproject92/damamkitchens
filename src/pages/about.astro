---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import IdentityCard from '../components/IdentityCard.astro';
---

<Layout
  title="من نحن | فني مطابخ وصيانة مطابخ بالدمام والشرقية"
  description="تعرف على خبرتنا الممتدة في صيانة، فك، تركيب، وتعديل مطابخ الألمنيوم والخشب والرخام بالدمام والمنطقة الشرقية. أمانة ودقة وأفضل قطع الغيار 0552854516."
  page="about"
>
  <Header slot="header" />

  <section class="page-hero" style="background-image: url('/assets/فني شركة صيانة مطابخ بالدمام0552854516.jpg');">
    <div class="container">
      <h1 data-ar="من نحن - فني مطابخ وصيانة مطابخ الدمام" data-en="About Us - Dammam Kitchen Maintenance">من نحن - فني مطابخ وصيانة مطابخ الدمام</h1>
      <p data-ar="رواد صيانة، فك وتركيب، وتعديل المطابخ وتصليح المفصلات والسحابات في الدمام والمنطقة الشرقية بأعلى معايير الإتقان المهني." data-en="Pioneers in kitchen maintenance, moving, resizing, hinge, and drawer repairs in Dammam and Eastern Province with top craftsmanship standards.">
        رواد صيانة، فك وتركيب، وتعديل المطابخ وتصليح المفصلات والسحابات في الدمام والمنطقة الشرقية بأعلى معايير الإتقان المهني.
      </p>
    </div>
  </section>

  <!-- STORY SECTION WITH REAL WORK PHOTO -->
  <section class="section">
    <div class="container">
      <div class="grid-2 story-grid">
        <div class="story-content">
          <span class="badge" data-ar="قصة نجاحنا" data-en="Our Story">قصة نجاحنا</span>
          <h2 class="section-title" data-ar="خبرة ممتدة في خدمة منازل الدمام والشرقية" data-en="Extensive Experience Serving Dammam Homes">خبرة ممتدة في خدمة منازل الدمام والشرقية</h2>
          <p data-ar="انطلقنا كفريق فني متخصص بعد ملاحظة المعاناة المستمرة التي تواجهها الأسر مع تلف مفصلات المطابخ، ارتخاء أبواب الخزائن، وسقوط السحابات. هدفنا الأساسي كان ولا يزال تقديم خدمة صيانة منزلية فورية تعيد لمطبخك رونقه واستقراره دون الحاجة لدفع مبالغ باهظة في تفصيل مطبخ جديد." data-en="We established as a specialized technical team addressing common kitchen issues: loose hinges, sagging doors, and jammed drawers. Our core mission is delivering rapid in-home repairs that restore kitchen stability without unnecessary costly replacements.">
            انطلقنا كفريق فني متخصص بعد ملاحظة المعاناة المستمرة التي تواجهها الأسر مع تلف مفصلات المطابخ، ارتخاء أبواب الخزائن، وسقوط السحابات. هدفنا الأساسي كان ولا يزال تقديم خدمة صيانة منزلية فورية تعيد لمطبخك رونقه واستقراره دون الحاجة لدفع مبالغ باهظة في تفصيل مطبخ جديد.
          </p>
          <p data-ar="على مدار أكثر من عقد من الزمان، صلحنا مئات المطابخ في مختلف أحياء الدمام والخبر والظهران، واكتسبنا ثقة عملائنا بفضل الشفافية التامة، احترام المواعيد، واستخدام أفضل قطع الغيار الإيطالية والألمانية." data-en="For over a decade, we have repaired hundreds of kitchens across Dammam, Khobar, and Dhahran, earning client trust through absolute transparency, punctuality, and top-tier Italian & German hardware.">
            على مدار أكثر من عقد من الزمان، صلحنا مئات المطابخ في مختلف أحياء الدمام والخبر والظهران، واكتسبنا ثقة عملائنا بفضل الشفافية التامة، احترام المواعيد، واستخدام أفضل قطع الغيار الإيطالية والألمانية.
          </p>
          <div class="story-actions">
            <a href="https://wa.me/966552854516?text=مرحباً، أود حجز فني صيانة مطابخ" class="btn btn-whatsapp" target="_blank" rel="noopener noreferrer">
              <span>💬</span>
              <span data-ar="تواصل معنا عبر واتساب" data-en="Contact Us via WhatsApp">تواصل معنا عبر واتساب</span>
            </a>
          </div>
        </div>

        <div class="story-media-wrap">
          <img
            src="/assets/فني شركة صيانة مطابخ بالدمام0552854516.jpg"
            alt="فني صيانة مطابخ بالدمام"
            class="story-photo card"
            width="600"
            height="400"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- PILLARS & VALUES -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title" data-ar="أهم ركائز وقيم عملنا" data-en="Our Core Pillars & Values">أهم ركائز وقيم عملنا</h2>
        <p class="section-subtitle" data-ar="معايير ثابتة نلتزم بها مع كل عميل في كافة مراحل الصيانة" data-en="Consistent standards we strictly adhere to across every repair job">معايير ثابتة نلتزم بها مع كل عميل في كافة مراحل الصيانة</p>
      </div>

      <div class="grid-3">
        <div class="card val-card">
          <div class="val-icon">🎯</div>
          <h3 data-ar="التشخيص الفني الدقيق" data-en="Accurate Diagnosis">التشخيص الفني الدقيق</h3>
          <p data-ar="نحدد العطل الجذري سواء كان تلفاً بالخشب، تآكلاً بالمفصلة، أو ارتخاءً بالقواعد، ونقدم حلاً نهائياً لا يتكرر." data-en="Identifying root issues whether substrate fatigue, hinge corrosion, or base looseness, delivering a permanent fix.">نحدد العطل الجذري سواء كان تلفاً بالخشب، تآكلاً بالمفصلة، أو ارتخاءً بالقواعد، ونقدم حلاً نهائياً لا يتكرر.</p>
        </div>

        <div class="card val-card">
          <div class="val-icon">🔩</div>
          <h3 data-ar="قطع غيار هيدروليك أصلية" data-en="Original Spare Hinges">قطع غيار هيدروليك أصلية</h3>
          <p data-ar="نوفر أجود أنواع المفصلات والسكك الإيطالية والألمانية المقاومة للرطوبة والمصممة للخدمة الشاقة لسنوات." data-en="Supplying top European rust-proof hydraulic hinges and heavy-duty ball-bearing rails engineered to last.">نوفر أجود أنواع المفصلات والسكك الإيطالية والألمانية المقاومة للرطوبة والمصممة للخدمة الشاقة لسنوات.</p>
        </div>

        <div class="card val-card">
          <div class="val-icon">⚡</div>
          <h3 data-ar="سرعة التجاوب والالتزام" data-en="Prompt Response">سرعة التجاوب والالتزام</h3>
          <p data-ar="حضور فوري لموقعك في الدمام ومناطق الشرقية من 7 صباحاً وحتى 2 بعد منتصف الليل مع ضمان إتقان ونظافة تامة." data-en="Immediate arrival across Dammam and Eastern Province daily from 7 AM to 2 AM with guaranteed clean work.">حضور فوري لموقعك في الدمام ومناطق الشرقية من 7 صباحاً وحتى 2 بعد منتصف الليل مع ضمان إتقان ونظافة تامة.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DIGITAL BUSINESS CARD -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title" data-ar="بيانات الفني الرسمية" data-en="Official Technician Credentials">بيانات الفني الرسمية</h2>
        <p class="section-subtitle" data-ar="تواصل مباشر وسريع دون وسطاء مع فني صيانة مطابخ الدمام" data-en="Direct communication with Dammam kitchen technician without middlemen">تواصل مباشر وسريع دون وسطاء مع فني صيانة مطابخ الدمام</p>
      </div>
      <IdentityCard />
    </div>
  </section>

  <FloatingCTA />
  <Footer slot="footer" />
</Layout>

<style>
.story-grid {
  align-items: center;
  gap: 3rem;
}

.story-content p {
  color: var(--text-secondary);
  font-size: 1.05rem;
  line-height: 1.8;
  margin-bottom: 1.25rem;
  text-align: start;
}

.story-actions {
  margin-top: 2rem;
}

.story-media-wrap {
  border-radius: var(--border-radius-xl);
  overflow: hidden;
}

.story-photo {
  width: 100%;
  height: auto;
  object-fit: contain;
  padding: 0;
  display: block;
}

.val-card {
  text-align: center;
}

.val-icon {
  font-size: 2.5rem;
  margin-bottom: 1rem;
}

.val-card h3 {
  color: var(--color-secondary);
  margin-bottom: 0.75rem;
}

[data-theme="dark"] .val-card h3 {
  color: var(--color-accent);
}

.val-card p {
  color: var(--text-secondary);
  line-height: 1.7;
  font-size: 0.95rem;
}

@media (max-width: 768px) {
  .story-content p { text-align: center; }
  .story-actions { text-align: center; }
}
</style>
