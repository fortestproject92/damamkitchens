              <li data-ar="✓ منع احتكاك الأبواب ببعضها" data-en="✓ Preventing door-to-door friction">✓ منع احتكاك الأبواب ببعضها</li>
              <li data-ar="✓ فحص المصدات والمغناطيس" data-en="✓ Checking catchers and bumpers">✓ فحص المصدات والمغناطيس</li>
            </ul>
            <div class="srv-btn-wrap">
              <a href="https://wa.me/966552854516?text=أرغب في خدمة وزن أبواب المطبخ" class="btn btn-whatsapp" target="_blank" rel="noopener noreferrer">
