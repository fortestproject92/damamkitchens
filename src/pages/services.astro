---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
---

<Layout
  title="خدمات صيانة المطابخ وإصلاح المفصلات في الدمام والشرقية"
  description="قائمة خدمات صيانة المطابخ الشاملة في الدمام: تغيير مفصلات هيدروليك، إصلاح أدراج وسحابات، وزن الأبواب الخشبية والألمنيوم، تقوية الرفوف. خدمة سريعة بدون وسطاء."
  page="services"
>
  <Header slot="header" />

  <section class="page-hero" style="background-image: url('/assets/تركيب مطابخ بالدمام.jpg');">
    <div class="container">
      <h1 data-ar="خدمات صيانة المطابخ وإصلاح المفصلات" data-en="Kitchen Maintenance & Hinge Repair Services">خدمات صيانة المطابخ وإصلاح المفصلات</h1>
      <p data-ar="حلول متخصصة ومتقنة لمعالجة كافة أعطال المطابخ المنزلية في الدمام والخبر ومناطق الشرقية." data-en="Specialized and expert solutions for all home kitchen issues across Dammam, Khobar and Eastern Province.">
        حلول متخصصة ومتقنة لمعالجة كافة أعطال المطابخ المنزلية في الدمام والخبر ومناطق الشرقية.
      </p>
    </div>
  </section>

  <!-- INSTALLATION & MAINTENANCE PROMO BANNER -->
  <section class="section-promo-banner container">
    <div class="services-banner-wrap">
      <img
        src="/assets/تركيب مطابخ بالدمام.jpg"
        alt="تركيب وصيانة مطابخ بالدمام"
        class="services-banner-img card"
        width="1000"
        height="500"
        loading="eager"
      />
    </div>
  </section>

  <!-- DETAILED SERVICES LIST WITH REAL PHOTOS -->
  <section class="section">
    <div class="container">
      <div class="services-list-grid">

        <!-- Service Item 1 -->
        <article class="service-detail-card card">
          <div class="srv-detail-img-box">
            <img src="/assets/1.jpg" alt="صيانة وإصلاح مفصلات المطابخ" class="srv-detail-img" width="400" height="320" loading="lazy" />
          </div>
          <div class="srv-content">
            <div class="srv-badge">01</div>
            <h2 data-ar="صيانة وإصلاح مفصلات المطابخ" data-en="Kitchen Hinge Repair & Re-alignment">صيانة وإصلاح مفصلات المطابخ</h2>
            <p data-ar="تعتبر المفصلات العنصر الأكثر تعرضاً للضغط اليومي في أي مطبخ. نقوم بإصلاح المفصلات التي تخلخلت براغيها، ومعالجة اتساع فتحات البراغي في الخشب أو الألمنيوم باستخدام حشوات فايبر مخصصة وبراغي صلبة لمنع تكرار الهبوط نهائياً." data-en="Hinges endure the most daily wear in kitchens. We fix loose screws, repair stripped screw holes in wood or aluminum with heavy-duty anchors, and prevent cabinet doors from sagging ever again.">
              تعتبر المفصلات العنصر الأكثر تعرضاً للضغط اليومي في أي مطبخ. نقوم بإصلاح المفصلات التي تخلخلت براغيها، ومعالجة اتساع فتحات البراغي في الخشب أو الألمنيوم باستخدام حشوات فايبر مخصصة وبراغي صلبة لمنع تكرار الهبوط نهائياً.
            </p>
            <ul class="srv-perks">
              <li data-ar="✓ وزن وتعديل زوايا الفتح والإغلاق" data-en="✓ Precision opening & closing alignment">✓ وزن وتعديل زوايا الفتح والإغلاق</li>
              <li data-ar="✓ تثبيت قواعد المفصلات التالفة" data-en="✓ Reinforcing damaged hinge base plates">✓ تثبيت قواعد المفصلات التالفة</li>
              <li data-ar="✓ إزالة أصوات الصرير والاحتكاك" data-en="✓ Squeak and friction noise elimination">✓ إزالة أصوات الصرير والاحتكاك</li>
            </ul>
            <div class="srv-btn-wrap">
              <a href="https://wa.me/966552854516?text=أرغب في خدمة صيانة وإصلاح مفصلات المطبخ" class="btn btn-whatsapp" target="_blank" rel="noopener noreferrer">
                <span>💬</span>
                <span data-ar="طلب الخدمة عبر واتساب" data-en="Book via WhatsApp">طلب الخدمة عبر واتساب</span>
              </a>
              <a href="tel:+966552854516" class="btn btn-outline">
                <span>📞</span>
                <span data-ar="اتصال مباشر" data-en="Direct Call">اتصال مباشر</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Service Item 2 -->
        <article class="service-detail-card card">
          <div class="srv-detail-img-box">
            <img src="/assets/2.jpg" alt="تركيب مفصلات هيدروليك ناعمة" class="srv-detail-img" width="400" height="320" loading="lazy" />
          </div>
          <div class="srv-content">
            <div class="srv-badge">02</div>
            <h2 data-ar="تركيب وترقية مفصلات هيدروليك ناعمة (Soft-Close)" data-en="Soft-Close Hydraulic Hinge Upgrade">تركيب وترقية مفصلات هيدروليك ناعمة (Soft-Close)</h2>
            <p data-ar="وداعاً لصوت ارتطام أبواب المطبخ المزعج. نوفر تركيب أحدث مفصلات الهيدروليك الإيطالية والألمانية التي تتميز بخاصية الإغلاق الهادئ والناعم، والتي تضمن حماية هيكل الدواليب من الصدمات والاهتزازات المستمرة." data-en="Say goodbye to slamming cabinet doors. We supply and install premium European soft-close hydraulic hinges that shut silently and smoothly, protecting cabinet structures from impacts.">
              وداعاً لصوت ارتطام أبواب المطبخ المزعج. نوفر تركيب أحدث مفصلات الهيدروليك الإيطالية والألمانية التي تتميز بخاصية الإغلاق الهادئ والناعم، والتي تضمن حماية هيكل الدواليب من الصدمات والاهتزازات المستمرة.
            </p>
            <ul class="srv-perks">
